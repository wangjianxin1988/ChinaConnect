---
import "@/styles/global.css";
import "@/styles/tailwind.css";
import EmergencyWrapper from "@/components/Emergency/EmergencyWrapper";
import InstallPrompt from "@/components/pwa/InstallPrompt";
import OfflineIndicator from "@/components/pwa/OfflineIndicator";
import { SUPPORTED_LANGUAGES, translations } from "@/i18n/translations";
import type { Language } from "@/i18n/translations";
import { generateHreflangUrlsWithDefault } from "@/lib/hreflang";
import type { HreflangUrl, SEOPageMeta } from "@/types/seo";

interface Props {
  title: string;
  description?: string;
  meta?: Partial<SEOPageMeta>;
  ogImage?: string;
  lang?: Language;
}

const SITE_URL = "https://chinaengage.org";
const SITE_NAME = "ChinaConnect";

const {
  title,
  description = "ChinaConnect - Connecting China with the World through culinary experiences",
  meta = {},
  ogImage,
  lang: propLang,
} = Astro.props;

const lang: Language = propLang || (Astro.locals.lang as Language) || "en";

const pageMeta: SEOPageMeta = {
  title,
  description,
  ...meta,
};

const canonicalUrl = meta.canonicalUrl || `${SITE_URL}${Astro.url.pathname}`;
const fullOgImage = ogImage || `${SITE_URL}/og-image.png`;
const pathname = Astro.url.pathname;

const hreflangUrls = generateHreflangUrlsWithDefault(pathname, SITE_URL);

function localeFor(code: string): string {
  const map: Record<string, string> = {
    en: "en_US", ja: "ja_JP", ko: "ko_KR",
    "zh-CN": "zh_CN", "zh-TW": "zh_TW",
    th: "th_TH", vi: "vi_VN", ru: "ru_RU",
    fr: "fr_FR", de: "de_DE", ar: "ar_AR", fa: "fa_IR",
  };
  return map[code] || "en_US";
}
const currentOgLocale = localeFor(lang);

const translationsJson = JSON.stringify(translations);
const supportedLanguagesJson = JSON.stringify(SUPPORTED_LANGUAGES);
const supabaseUrlJson = JSON.stringify(import.meta.env.PUBLIC_SUPABASE_URL || "");
const supabaseAnonKeyJson = JSON.stringify(import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "");
---

<!doctype html>
<html lang={lang} dir={lang === "ar" || lang === "fa" ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />

    <!-- PWA / Theme Color -->
    <meta name="theme-color" content="#3b82f6" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ChinaConnect" />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Primary Meta Tags -->
    <title>{pageMeta.title}</title>
    <meta name="description" content={pageMeta.description} />
    {pageMeta.keywords && pageMeta.keywords.length > 0 && (
      <meta name="keywords" content={pageMeta.keywords.join(', ')} />
    )}
    {pageMeta.noIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- AI Crawler Meta -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags for 12 Languages -->
    {hreflangUrls.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageMeta.title} />
    <meta property="og:description" content={pageMeta.description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={currentOgLocale} />
    {SUPPORTED_LANGUAGES.filter(l => l.code !== lang).slice(0, 5).map(l => (
      <meta property="og:locale:alternate" content={localeFor(l.code)} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageMeta.title} />
    <meta name="twitter:description" content={pageMeta.description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:site" content="@chinaconnect" />

    <meta name="theme-color" content="#3b82f6" />

    <title>{title}</title>

    <!--
      Boot: expose i18n + Supabase creds globally. Safe parse: a failure here does not break UI.
      All UI logic (language switcher, auth nav) lives in a single idempotent runtime script below.
    -->
    <script is:inline define:vars={{ translationsJson, supportedLanguagesJson, supabaseUrlJson, supabaseAnonKeyJson, lang }}>
      (function () {
        try {
          window.__SUPABASE_URL__ = JSON.parse(supabaseUrlJson) || "";
          window.__SUPABASE_ANON_KEY__ = JSON.parse(supabaseAnonKeyJson) || "";
          window.__I18N__ = {
            translations: JSON.parse(translationsJson) || {},
            languages: JSON.parse(supportedLanguagesJson) || [],
            serverLang: lang,
          };
        } catch (err) {
          console.warn("[i18n boot] parse failed:", err);
          window.__SUPABASE_URL__ = window.__SUPABASE_URL__ || "";
          window.__SUPABASE_ANON_KEY__ = window.__SUPABASE_ANON_KEY__ || "";
          window.__I18N__ = window.__I18N__ || { translations: {}, languages: [], serverLang: lang };
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-200">
      <div class="container-custom">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
            <img src="/logo.svg" alt="ChinaConnect" class="w-10 h-10 rounded-lg" />
            <div>
              <span class="font-semibold text-lg text-gray-900">ChinaConnect</span>
              <span class="block text-xs text-gray-500" data-i18n="nav.tagline">Explore China with AI</span>
            </div>
          </a>

          <div class="hidden md:flex items-center gap-6">
            <a href="/" class="text-gray-600 hover:text-gray-900 font-medium transition-colors" data-i18n="nav.home">Home</a>
            <a href="/cities" class="text-gray-600 hover:text-gray-900 font-medium transition-colors" data-i18n="nav.cities">Cities</a>
            <a href="/attractions" class="text-gray-600 hover:text-gray-900 font-medium transition-colors" data-i18n="nav.attractions">Attractions</a>
            <a href="/scenic-spots" class="text-gray-600 hover:text-gray-900 font-medium transition-colors" data-i18n="nav.scenicSpots">Scenic Spots</a>
            <a href="/food" class="text-gray-600 hover:text-gray-900 font-medium transition-colors" data-i18n="nav.restaurants">Restaurants</a>
            <a href="/ai" class="text-purple-600 hover:text-purple-700 font-semibold transition-colors flex items-center gap-1.5 px-3 py-1.5 bg-purple-50 rounded-lg">
              <span>&#10022;</span>
              <span data-i18n="nav.aiChat">ChinaGuide AI</span>
            </a>
            <a href="/guide" class="text-gray-600 hover:text-gray-900 font-medium transition-colors" data-i18n="nav.guide">Travel Guide</a>
          </div>

          <div class="flex items-center gap-3">
            <div id="auth-nav-container" class="flex items-center">
            <a href="/auth/login" class="flex items-center gap-2 px-4 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition-colors" aria-label="Sign In" data-i18n-aria="auth.signIn">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              <span data-i18n="auth.signIn">Sign In</span>
            </a>
          </div>

            <div class="relative" id="lang-switcher-container">
              <button
                id="lang-switcher"
                type="button"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 text-blue-600 text-sm font-medium hover:bg-blue-100 transition-colors"
                title="Switch Language"
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span id="lang-current">EN</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                </svg>
              </button>
              <div id="lang-menu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 max-h-80 overflow-y-auto" role="listbox">
                <div class="px-3 py-2 text-xs text-gray-500 border-b border-gray-100" data-i18n="nav.selectLanguage">Select Language</div>
                <ul id="lang-list" class="py-2"></ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <EmergencyWrapper client:load />
    <InstallPrompt client:load />
    <OfflineIndicator client:load />


    <!--
      Unified runtime: language switcher + i18n apply + auth nav.
      Single script, idempotent (window.__CC_RUNTIME__ guard), View-Transitions safe,
      event-delegated. Decoupled from the translations JSON parse so failures
      in one area never break the others.
    -->
    <script is:inline>
      (function () {
        if (window.__CC_RUNTIME__) return;
        window.__CC_RUNTIME__ = true;

        var RTL_LANGS = ["ar", "fa"];
        var LANG_STORAGE_KEY = "chinaconnect_language";

        function safeGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function safeSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

        function getLangInfo() {
          var dict = (window.__I18N__ && window.__I18N__.translations) || {};
          var langs = (window.__I18N__ && window.__I18N__.languages) || [];

          var stored = safeGet(LANG_STORAGE_KEY);
          if (stored && dict[stored]) return { lang: stored, t: dict[stored], langs: langs };

          var serverLang = (window.__I18N__ && window.__I18N__.serverLang) || "en";
          if (serverLang && dict[serverLang]) {
            safeSet(LANG_STORAGE_KEY, serverLang);
            return { lang: serverLang, t: dict[serverLang], langs: langs };
          }

          var bl = (navigator.language || "en").toLowerCase();
          function pick(code) {
            return { lang: code, t: dict[code] || dict["en"] || {}, langs: langs };
          }
          if (bl.startsWith("ja")) return pick("ja");
          if (bl.startsWith("ko")) return pick("ko");
          if (bl.startsWith("zh")) return pick(bl.indexOf("tw") >= 0 || bl.indexOf("hk") >= 0 ? "zh-TW" : "zh-CN");
          if (bl.startsWith("th")) return pick("th");
          if (bl.startsWith("vi")) return pick("vi");
          if (bl.startsWith("ru")) return pick("ru");
          if (bl.startsWith("ar")) return pick("ar");
          if (bl.startsWith("fa")) return pick("fa");
          if (bl.startsWith("de")) return pick("de");
          if (bl.startsWith("fr")) return pick("fr");
          return pick("en");
        }

        function lookup(t, key) {
          var parts = key.split(".");
          var cur = t;
          for (var i = 0; i < parts.length; i++) {
            if (cur && typeof cur === "object" && parts[i] in cur) cur = cur[parts[i]];
            else return undefined;
          }
          return typeof cur === "string" ? cur : undefined;
        }

        function applyTranslationsTo(root) {
          if (!root) return;
          var t = getLangInfo().t;
          var nodes = root.querySelectorAll("[data-i18n]");
          for (var i = 0; i < nodes.length; i++) {
            var k = nodes[i].getAttribute("data-i18n");
            if (!k) continue;
            var v = lookup(t, k);
            if (typeof v === "string") nodes[i].textContent = v;
          }
          nodes = root.querySelectorAll("[data-i18n-placeholder]");
          for (var j = 0; j < nodes.length; j++) {
            var k2 = nodes[j].getAttribute("data-i18n-placeholder");
            if (!k2) continue;
            var v2 = lookup(t, k2);
            if (typeof v2 === "string") nodes[j].placeholder = v2;
          }
          nodes = root.querySelectorAll("[data-i18n-title]");
          for (var k3 = 0; k3 < nodes.length; k3++) {
            var kk = nodes[k3].getAttribute("data-i18n-title");
            if (!kk) continue;
            var vv = lookup(t, kk);
            if (typeof vv === "string") nodes[k3].setAttribute("title", vv);
          }
          nodes = root.querySelectorAll("[data-i18n-aria]");
          for (var k4 = 0; k4 < nodes.length; k4++) {
            var kkk = nodes[k4].getAttribute("data-i18n-aria");
            if (!kkk) continue;
            var vvv = lookup(t, kkk);
            if (typeof vvv === "string") nodes[k4].setAttribute("aria-label", vvv);
          }
        }

        function applyLangAttributes(lang) {
          document.documentElement.lang = lang;
          document.documentElement.dir = RTL_LANGS.indexOf(lang) >= 0 ? "rtl" : "ltr";
        }

        function buildLangMenu() {
          var list = document.getElementById("lang-list");
          if (!list) return;
          var info = getLangInfo();
          var current = info.lang;
          var langs = info.langs || [];

          list.innerHTML = "";
          if (!langs.length) {
            list.innerHTML = '<li class="px-3 py-2 text-sm text-gray-400">Loading&#8230;</li>';
            return;
          }

          for (var i = 0; i < langs.length; i++) {
            (function (entry) {
              var li = document.createElement("li");
              var btn = document.createElement("button");
              btn.type = "button";
              btn.className = "w-full text-left px-3 py-2 text-sm hover:bg-gray-50 flex items-center justify-between gap-2";
              btn.setAttribute("data-lang", entry.code);
              btn.setAttribute("role", "option");
              if (entry.code === current) btn.classList.add("bg-blue-50", "text-blue-600");

              var badge =
                entry.code === "zh-CN" ? "\u7b80" :
                entry.code === "zh-TW" ? "\u7e41" :
                entry.code === "en" ? "EN" :
                entry.code.toUpperCase();

              btn.innerHTML =
                '<span class="flex items-center gap-2">' +
                  '<span class="inline-block w-6 text-center text-xs font-mono text-gray-500">' + badge + '</span>' +
                  '<span>' + (entry.nativeName || entry.name || entry.code) + '</span>' +
                '</span>' +
                (entry.code === current
                  ? '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>'
                  : "");

              li.appendChild(btn);
              list.appendChild(li);
            })(langs[i]);
          }

          var label = document.getElementById("lang-current");
          if (label) {
            var cur = langs.find(function (l) { return l.code === current; });
            label.textContent = cur ? cur.code.toUpperCase().split("-")[0] : current.toUpperCase();
          }
        }

        function closeLangMenu() {
          var menu = document.getElementById("lang-menu");
          var btn = document.getElementById("lang-switcher");
          if (menu) menu.classList.add("hidden");
          if (btn) btn.setAttribute("aria-expanded", "false");
        }

        function openLangMenu() {
          var menu = document.getElementById("lang-menu");
          var btn = document.getElementById("lang-switcher");
          if (menu) menu.classList.remove("hidden");
          if (btn) btn.setAttribute("aria-expanded", "true");
        }

        function toggleLangMenu() {
          var menu = document.getElementById("lang-menu");
          if (!menu) return;
          if (menu.classList.contains("hidden")) openLangMenu();
          else closeLangMenu();
        }

        function switchLanguage(newLang) {
          if (!newLang) return;
          if (newLang === getLangInfo().lang) { closeLangMenu(); return; }
          safeSet(LANG_STORAGE_KEY, newLang);
          closeLangMenu();

          // Navigate to /<lang>/<path> instead of just adding ?lang=<lang>.
          // Strip the existing language prefix (if any), then prepend the new one.
          try {
            var currentPath = window.location.pathname;
            var pathNoLang = currentPath.replace(/^\/(en|ja|ko|zh-CN|zh-TW|th|vi|ru|fr|de|ar|fa)\//, "/");
            var newPath = (newLang === "en" ? "" : "/" + newLang) + pathNoLang;
            var full = newPath + window.location.search + window.location.hash;
            window.location.href = full;
          } catch (e) { console.warn("[i18n] switch failed", e); }
        }

        function initLanguageUI() {
          var info = getLangInfo();
          applyLangAttributes(info.lang);
          applyTranslationsTo(document);
          buildLangMenu();
        }

        document.addEventListener("click", function (e) {
          var target = e.target;
          if (!(target instanceof Element)) return;

          var switcher = target.closest("#lang-switcher");
          if (switcher) {
            e.preventDefault();
            toggleLangMenu();
            return;
          }

          var option = target.closest("[data-lang]");
          if (option) {
            e.preventDefault();
            switchLanguage(option.getAttribute("data-lang"));
            return;
          }

          var container = document.getElementById("lang-switcher-container");
          if (container && !container.contains(target)) closeLangMenu();
        });

        function runLangInit() {
          try { initLanguageUI(); } catch (e) { console.warn("[i18n] init failed", e); }
        }
        document.addEventListener("DOMContentLoaded", runLangInit);
        if (document.readyState !== "loading") runLangInit();
        document.addEventListener("astro:after-swap", runLangInit);
        document.addEventListener("astro:page-load", runLangInit);


        // =============== Auth Nav ===============
        function escapeHtml(s) {
          if (s == null) return "";
          return String(s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
        }

        function renderLoggedOut() {
          var c = document.getElementById("auth-nav-container");
          if (!c) return;
          c.innerHTML =
            '<a href="/auth/login" class="flex items-center gap-2 px-4 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium transition-colors" aria-label="Sign In">' +
              '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>' +
              '<span data-i18n="auth.signIn">' + escapeHtml("Sign In") + '</span>' +
            '</a>';
          applyTranslationsTo(c);
        }

        function renderLoggedIn(user) {
          var c = document.getElementById("auth-nav-container");
          if (!c) return;
          var avatar = user.avatarUrl;
          var initial = (user.displayName || user.email || "U").charAt(0).toUpperCase();
          var avatarHtml = avatar
            ? '<img src="' + escapeHtml(avatar) + '" alt="" class="w-7 h-7 rounded-full object-cover" />'
            : '<div class="w-7 h-7 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 text-white flex items-center justify-center text-xs font-bold">' + escapeHtml(initial) + '</div>';

          c.innerHTML =
            '<div class="relative" id="cc-user-menu">' +
              '<button id="cc-user-trigger" type="button" class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-gray-100 transition-colors" aria-haspopup="menu" aria-expanded="false">' +
                avatarHtml +
                '<span class="hidden sm:inline text-sm font-medium text-gray-700 max-w-[120px] truncate">' + escapeHtml(user.displayName || user.email || "User") + '</span>' +
                '<svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>' +
              '</button>' +
              '<div id="cc-user-dropdown" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-50" role="menu">' +
                '<div class="px-4 py-3 border-b border-gray-100">' +
                  '<p class="text-sm font-medium text-gray-900 truncate">' + escapeHtml(user.displayName || "User") + '</p>' +
                  '<p class="text-xs text-gray-500 truncate">' + escapeHtml(user.email || "") + '</p>' +
                '</div>' +
                '<a href="/account" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" role="menuitem">' +
                  '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>' +
                  '<span data-i18n="auth.myAccount">' + escapeHtml("My Account") + '</span>' +
                '</a>' +
                '<a href="/profile" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" role="menuitem">' +
                  '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>' +
                  '<span data-i18n="auth.profileCenter">' + escapeHtml("Profile Center") + '</span>' +
                '</a>' +
                '<div class="border-t border-gray-100 my-1"></div>' +
                '<button id="cc-signout" type="button" class="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50" role="menuitem">' +
                  '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>' +
                  '<span data-i18n="auth.signOut">' + escapeHtml("Sign Out") + '</span>' +
                '</button>' +
              '</div>' +
            '</div>';

          var trigger = document.getElementById("cc-user-trigger");
          var dropdown = document.getElementById("cc-user-dropdown");
          if (trigger && dropdown) {
            trigger.addEventListener("click", function (e) {
              e.preventDefault();
              e.stopPropagation();
              if (dropdown.classList.contains("hidden")) {
                dropdown.classList.remove("hidden");
                trigger.setAttribute("aria-expanded", "true");
              } else {
                dropdown.classList.add("hidden");
                trigger.setAttribute("aria-expanded", "false");
              }
            });
          }
          var so = document.getElementById("cc-signout");
          if (so) {
            so.addEventListener("click", function (e) {
              e.preventDefault();
              fetch(window.location.origin + "/api/auth/signout", { method: "POST", credentials: "same-origin" })
                .catch(function () {})
                .finally(function () {
                  window.dispatchEvent(new CustomEvent("cc-auth-changed", { detail: { authenticated: false } }));
                  if (window.location.pathname.indexOf("/account") === 0) {
                    window.location.href = "/";
                  } else {
                    window.location.reload();
                  }
                });
            });
          }
          applyTranslationsTo(c);
        }

        document.addEventListener("click", function (e) {
          var menu = document.getElementById("cc-user-menu");
          if (!menu || !(e.target instanceof Element)) return;
          if (!menu.contains(e.target)) {
            var dd = document.getElementById("cc-user-dropdown");
            if (dd) dd.classList.add("hidden");
            var tr = document.getElementById("cc-user-trigger");
            if (tr) tr.setAttribute("aria-expanded", "false");
          }
        });

        function refreshAuthNav() {
          var c = document.getElementById("auth-nav-container");
          if (!c) return;
          fetch(window.location.origin + "/api/auth/state", { credentials: "same-origin", cache: "no-store" })
            .then(function (r) { return r && r.ok ? r.json() : { authenticated: false }; })
            .then(function (data) {
              if (data && data.authenticated && data.user) renderLoggedIn(data.user);
              else renderLoggedOut();
            })
            .catch(function () { renderLoggedOut(); });
        }

        function runAuthInit() {
          try { refreshAuthNav(); } catch (e) { console.warn("[auth] init failed", e); }
        }
        document.addEventListener("DOMContentLoaded", runAuthInit);
        if (document.readyState !== "loading") runAuthInit();
        document.addEventListener("astro:after-swap", runAuthInit);
        document.addEventListener("astro:page-load", runAuthInit);

        window.addEventListener("cc-auth-changed", runAuthInit);
      })();
    </script>


