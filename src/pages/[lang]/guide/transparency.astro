---

export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"];
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang as string) || "en";


import PriceTransparencyClient from "@/components/Guide/PriceTransparencyClient";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { translations } from "@/i18n/translations";
import { getLangFromUrl } from '@/i18n/utils';

const pageTitle = translations.en.guidePage?.transparencyTitle || "Price Transparency - ChinaConnect";
const pageDescription = translations.en.guidePage?.transparencyDescription || "Know fair prices and avoid being overcharged while traveling in China.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <a href="/" class="text-primary hover:underline mb-4 inline-block" data-i18n="guidePage.backHome">← Back to Home</a>
      <h1 class="text-4xl font-bold text-foreground" data-i18n="guidePage.transparencyTitleShort">Price Transparency Guide</h1>
      <p class="text-muted-foreground mt-2 text-lg" data-i18n="guidePage.transparencySubtitle">
        Price Transparency - Know the fair prices, avoid being overcharged
      </p>
    </div>

    <PriceTransparencyClient client:load lang={lang} />
  </main>
</BaseLayout>
