---
import { ResetPasswordPage } from '@/components/user/ResetPasswordPage';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { authT } from '@/components/user/auth-strings';
import type { Language } from "@/i18n/translations";

export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"] as const;
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang as Language) || "en";
const title = authT(lang, "resetPageTitle");
---

<BaseLayout title={title}>
  <main class="min-h-screen py-12 bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <ResetPasswordPage client:load lang={lang} />
    </div>
  </main>
</BaseLayout>
