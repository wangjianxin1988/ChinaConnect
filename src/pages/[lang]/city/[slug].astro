---
import EmbeddedAppRecommendation from "@/components/apps/EmbeddedAppRecommendation";
import { InlineAppPillsGroup, getAppsForSection } from "@/components/apps/InlineAppPills";
import { pruneAppsForLang } from "@/data/apps/app-recommendations";
import AIRecommendation from "@/components/city/AIRecommendation.astro";
import { AttractionCard } from "@/components/city/AttractionCard";
import { AttractionsSection } from "@/components/city/AttractionsSection";
import { CityMap } from "@/components/city/CityMap";
import { CityTierBadge } from "@/components/city/CityTierBadge";
import { CulturalSection } from "@/components/city/CulturalSection";
import { EmergencyCard, QuickDialGrid } from "@/components/city/EmergencyCard";
import { ct } from "@/i18n/components-strings";
import { translations } from "@/i18n/translations";
import { EmergencySection } from "@/components/city/EmergencySection";
import { FoodHighlightsSection } from "@/components/city/FoodHighlightsSection";
import { WeatherWidget } from "@/components/city/WeatherWidget";
import { WEATHER_CONDITIONS, WEATHER_DEMO, WEATHER_LABELS } from "@/i18n/weather";
import { citySlugs, getAdjacentCities, getCityBySlug } from "@/data/cities/index";
import { cityDisplayName, pruneCityEntityNames } from "@/lib/city-name";
import { getCityData } from "@/data/cities-i18n";
import { S_TIER_CITIES } from "@/data/cities/tier-data";
import { getHotelsByCity, getHotelCategoryCounts, getHotelCount } from "@/data/hotels";
import { HOTEL_CATEGORY_CONFIG } from "@/types/accommodation";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  const langs = ["en", "ja", "ko", "zh-CN", "zh-TW", "th", "vi", "ru", "fr", "de", "ar", "fa"] as const;
  return langs.flatMap((lang) => citySlugs.map((slug) => ({ params: { lang, slug } })));
}

const { slug, lang: paramLang } = Astro.params;
const lang = (paramLang as string) || "en";
const city = pruneCityEntityNames(
  getCityData(slug as string, lang) || getCityBySlug(slug as string),
  lang,
);

if (!city) {
  return Astro.redirect("/404");
}

const { prev, next } = getAdjacentCities(slug as string);

// Get unified hotel data
const unifiedHotels = getHotelsByCity(slug as string, lang);
const hotelCategoryCounts = getHotelCategoryCounts(slug as string, lang);
const totalHotelCount = getHotelCount(slug as string, lang);

const i18nCity = lang !== "en" ? getCityData(city.slug, lang) : null;
const localCityName = translations[lang]?.["city." + city.slug + ".name"] ?? translations.en?.["city." + city.slug + ".name"] ?? cityDisplayName(i18nCity ?? city, lang);
const isJapanese = lang === "ja";
const langPrefix = lang === "en" ? "" : `/${lang}`;
const weatherI18n = {
  cityPage: {
    weatherHumidity: translations[lang]?.cityPage?.weatherHumidity ?? WEATHER_LABELS[lang]?.weatherHumidity,
    weatherWind: translations[lang]?.cityPage?.weatherWind ?? WEATHER_LABELS[lang]?.weatherWind,
    weatherFeels: translations[lang]?.cityPage?.weatherFeels ?? WEATHER_LABELS[lang]?.weatherFeels,
    weatherForecast: translations[lang]?.cityPage?.weatherForecast,
    weatherDemo: WEATHER_DEMO[lang] ?? translations[lang]?.cityPage?.weatherDemo,
    weatherNA: translations[lang]?.cityPage?.weatherNA,
    weatherNotAvailable: translations[lang]?.cityPage?.weatherNotAvailable,
  },
  weather: {
    toggleUnit: lang === "ja" ? "温度単位を切り替え" : "Toggle temperature unit",
    toggleUnitCelsius: "°C",
    toggleUnitFahrenheit: "°F",
    rainProbability: WEATHER_LABELS[lang]?.rainProbability ?? "rain",
    conditions: WEATHER_CONDITIONS[lang] || {},
  },
};
const pageTitle = (translations[lang] || translations.en).cityPage?.pageTitle?.replace("{city}", localCityName) ?? `${localCityName} ${(translations.en.cityPage?.pageTitleSuffix ?? "Travel Guide - ChinaConnect")}`;
const pageDescription = (translations[lang] || translations.en).cityPage?.citySubtitle?.replace("{city}", localCityName) ?? `Complete travel guide for ${localCityName}, ${city.nameEn}.`;

// Schema.org uses the CJK name only on zh/ja pages; elsewhere English
const schemaCityName = lang === "zh-CN" || lang === "zh-TW" || lang === "ja" ? city.name : city.nameEn;

// SEO keywords
const keywords = [
  city.nameEn,
  ...(lang === "zh-CN" || lang === "zh-TW" || lang === "ja" ? [city.name] : []),
  `${localCityName} travel guide`,
  `${localCityName} attractions`,
  `${localCityName} restaurants`,
  `${localCityName} hotels`,
  `${localCityName} food`,
  `travel to ${localCityName}`,
  `China travel`,
  `${city.attractions[0]?.nameEn || ""}`,
  `${city.restaurants[0]?.nameEn || ""}`,
].filter(Boolean);

// City Schema.org JSON-LD
const citySchema = {
  "@context": "https://schema.org",
  "@type": "City",
  name: city.nameEn,
  alternateName: schemaCityName,
  description: city.description,
  geo: {
    "@type": "GeoCoordinates",
    latitude: city.coordinates.lat.toString(),
    longitude: city.coordinates.lng.toString(),
  },
  address: {
    "@type": "PostalAddress",
    addressCountry: "CN",
    addressRegion: schemaCityName,
  },
  population: city.population,
  url: `https://chinaengage.org${langPrefix}/city/${city.slug}`,
  photo: city.coverImage,
  aggregateRating:
    city.restaurants.length > 0
      ? {
          "@type": "AggregateRating",
          ratingValue: (
            city.restaurants.reduce((sum, r) => sum + r.rating, 0) / city.restaurants.length
          ).toFixed(1),
          reviewCount: city.restaurants.length,
        }
      : undefined,
  mainEntity: {
    "@type": "TravelAction",
    name: `Visit ${localCityName}`,
    location: {
      "@type": "City",
      name: city.nameEn,
    },
  },
};

// Tourist attractions as part of the city
const attractionSchemas = city.attractions.slice(0, 5).map((attraction, index) => ({
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  name: attraction.nameEn,
  alternateName: attraction.name,
  description: attraction.description,
  geo: {
    "@type": "GeoCoordinates",
    latitude: attraction.coordinates.lat.toString(),
    longitude: attraction.coordinates.lng.toString(),
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: attraction.address,
    addressCountry: "CN",
    addressRegion: city.name,
  },
  openingHours: attraction.openingHours,
  touristType: attraction.category,
  isPartOf: {
    "@type": "City",
    name: city.nameEn,
  },
}));

// Restaurant schemas
const restaurantSchemas = city.restaurants.slice(0, 5).map((restaurant) => ({
  "@context": "https://schema.org",
  "@type": restaurant.type === "michelin" ? "Restaurant" : "Restaurant",
  name: restaurant.nameEn,
  alternateName: restaurant.name,
  description: restaurant.description,
  servesCuisine: restaurant.cuisine,
  priceRange: `$${Math.round(restaurant.avgPrice / 2)} - $${Math.round(restaurant.avgPrice * 1.5)}`,
  aggregateRating: restaurant.rating
    ? {
        "@type": "AggregateRating",
        ratingValue: restaurant.rating.toString(),
        reviewCount: "100",
      }
    : undefined,
  address: {
    "@type": "PostalAddress",
    streetAddress: restaurant.address,
    addressCountry: "CN",
    addressRegion: city.name,
  },
  geo: restaurant.coordinates
    ? {
        "@type": "GeoCoordinates",
        latitude: restaurant.coordinates.lat.toString(),
        longitude: restaurant.coordinates.lng.toString(),
      }
    : undefined,
  telephone: restaurant.phone,
  openingHoursSpecification: restaurant.hours
    ? {
        "@type": "OpeningHoursSpecification",
        description: restaurant.hours,
      }
    : undefined,
  starRating: restaurant.star
    ? {
        "@type": "Rating",
        ratingValue: restaurant.star.toString(),
        bestRating: "3",
      }
    : undefined,
  isPartOf: {
    "@type": "City",
    name: city.nameEn,
  },
}));

// BreadcrumbList schema for SEO
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: translations[lang]?.nav?.home ?? "Home",
      item: `https://chinaengage.org${langPrefix}`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: translations[lang]?.nav?.cities ?? "Cities",
      item: `https://chinaengage.org${langPrefix}/#cities`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: localCityName,
      item: `https://chinaengage.org${langPrefix}/city/${city.slug}`,
    },
  ],
};

// hreflang URLs for this city page
const SITE_URL = "https://chinaengage.org";
const enCityUrl = `${SITE_URL}/city/${city.slug}`;
const zhCityUrl = `${SITE_URL}/zh/city/${city.slug}`;
const jaCityUrl = `${SITE_URL}/ja/city/${city.slug}`;

const _t = translations[lang] || translations.en;
const _lookup = (key, vars) => {
  if (vars === undefined) vars = { city: localCityName };
  const parts = key.split('.');
  let cur = _t;
  for (const k of parts) { if (cur && typeof cur === 'object' && k in cur) cur = cur[k]; else return key; }
  if (typeof cur !== 'string') return key;
  return cur.replace(/\{(\w+)\}/g, (m, k) => (vars && k in vars ? String(vars[k]) : ''));
};
const HOTEL_CAT_LABELS: Record<string, Record<string, string>> = {
  luxury: { en: "Luxury", ja: "ラグジュアリー", ko: "럭셔리", "zh-CN": "豪华", "zh-TW": "豪華", th: "หรูหรา", vi: "Sang trọng", ru: "Люкс", fr: "Luxe", de: "Luxus", ar: "فاخر", fa: "لاکچری" },
  mid_range: { en: "Mid-Range", ja: "ミッドレンジ", ko: "중급", "zh-CN": "中端", "zh-TW": "中價位", th: "ระดับกลาง", vi: "Tầm trung", ru: "Средний", fr: "Milieu de gamme", de: "Mittelklasse", ar: "متوسط", fa: "متوسط" },
  budget: { en: "Budget", ja: "バジェット", ko: "예산", "zh-CN": "经济", "zh-TW": "經濟", th: "ประหยัด", vi: "Bình dân", ru: "Бюджетный", fr: "Économique", de: "Budget", ar: "اقتصادي", fa: "اقتصادی" },
  hostel: { en: "Hostel", ja: "ホステル", ko: "호스텔", "zh-CN": "青年旅舍", "zh-TW": "青年旅館", th: "โฮสเทล", vi: "Nhà nghỉ", ru: "Хостел", fr: "Auberge", de: "Hostel", ar: "نزل شبابي", fa: "هاستل" },
  love_hotel: { en: "Love Hotel", ja: "ラブホテル", ko: "러브호텔", "zh-CN": "情趣酒店", "zh-TW": "情趣旅館", th: "เลิฟโฮเทล", vi: "Khách sạn tình nhân", ru: "Love-отель", fr: "Love hotel", de: "Love Hotel", ar: "فندق رومانسي", fa: "هتل عاشقانه" },
  esports_hotel: { en: "Esports", ja: "eスポーツ", ko: "e스포츠", "zh-CN": "电竞酒店", "zh-TW": "電競旅館", th: "อีสปอร์ต", vi: "Esports", ru: "Киберспорт", fr: "Esport", de: "Esports", ar: "رياضات إلكترونية", fa: "ایاسپرت" },
};
const hotelCatLabel = (key: string) => HOTEL_CAT_LABELS[key]?.[lang] || HOTEL_CAT_LABELS[key]?.en || key;
const modules = [
  { id: "overview", label: () => _lookup('cityPage.tabOverview'), icon: "📍", colorClass: "bg-blue-50 text-blue-700 hover:bg-blue-100" },
  { id: "food-highlights", label: () => _lookup('cityPage.tabFood'), icon: "🍜", colorClass: "bg-orange-50 text-orange-700 hover:bg-orange-100" },
  { id: "attractions", label: () => _lookup('cityPage.tabAttractions'), icon: "🏛", colorClass: "bg-purple-50 text-purple-700 hover:bg-purple-100" },
  { id: "transport", label: () => _lookup('cityPage.tabTransport'), icon: "🚇", colorClass: "bg-green-50 text-green-700 hover:bg-green-100" },
  { id: "accommodation", label: () => _lookup('cityPage.tabHotels'), icon: "🏨", colorClass: "bg-teal-50 text-teal-700 hover:bg-teal-100" },
  { id: "payment", label: () => _lookup('cityPage.tabPayment'), icon: "💳", colorClass: "bg-indigo-50 text-indigo-700 hover:bg-indigo-100" },
  { id: "connectivity", label: () => _lookup('cityPage.tabConnectivity'), icon: "📶", colorClass: "bg-cyan-50 text-cyan-700 hover:bg-cyan-100" },
  { id: "apps", label: () => _lookup('cityPage.tabApps'), icon: "📱", colorClass: "bg-gray-50 text-gray-700 hover:bg-gray-100" },
  { id: "culture", label: () => _lookup('cityPage.tabCulture'), icon: "🎎", colorClass: "bg-pink-50 text-pink-700 hover:bg-pink-100" },
  { id: "emergency", label: () => _lookup('cityPage.tabEmergency'), icon: "🚨", colorClass: "bg-red-50 text-red-700 hover:bg-red-100" },
];

function getBadgeClass(type: string) {
  if (type === "michelin") return "badge-michelin";
  if (type === "blackpearl") return "badge-blackpearl";
  return "badge-local";
}

// Render transport list items that may be strings, nested string arrays, or objects
function formatTransportItem(item: unknown): string {
  if (typeof item === "string") return item;
  if (Array.isArray(item)) return item.map((x) => formatTransportItem(x)).join(", ");
  if (item && typeof item === "object") {
    const parts = Object.values(item as Record<string, unknown>)
      .filter((v): v is string => typeof v === "string" && v.length > 0 && v !== "N/A")
      .map((v) => v.trim());
    return parts.join(" · ");
  }
  return String(item);
}


// Map payment method name to i18n key
function payKey(method: string): string {
  const m = method.toLowerCase();
  if (m === "alipay") return "pay_alipay";
  if (m === "wechat pay") return "pay_wechat";
  if (m === "cash") return "pay_cash";
  if (m === "cash (rmb)") return "pay_cash_rmb";
  if (m === "cash (cny)") return "pay_cash";
  if (m === "unionpay") return "pay_unionpay";
  if (m === "china unionpay") return "pay_unionpay";
  if (m === "credit cards") return "pay_credit_cards";
  if (m === "international credit cards") return "pay_intl_credit_cards";
  if (m === "foreign exchange") return "pay_foreign_exchange";
  if (m === "traveler's cheques" || m === "traveler checks") return "pay_travelers_checks";
  if (m === "international cards") return "pay_international_cards";
  if (m === "changsha tong card") return "pay_changsha_tong";
  if (m === "wuhan tong card") return "pay_wuhan_tong";
  if (m === "beer voucher") return "pay_beer_voucher";
  if (m === "apple pay / contactless") return "pay_apple_pay_contactless";
  if (m === "apple pay / google pay") return "pay_apple_google_pay";
  if (m === "mobile payment via digital wallet") return "pay_mobile_wallet";
  if (m === "mobile wallets (apple pay/google pay)") return "pay_mobile_wallets";
  if (m === "visa/mastercard") return "pay_visa_mastercard";
  return "";
}

// Derived data for template use
const hospitals = city.emergencyContacts.filter((c) => c.type === "hospital");
const embassies = city.emergencyContacts.filter((c) => c.type === "embassy");
const emergencyOthers = city.emergencyContacts.filter(
  (c) => c.type !== "hospital" && c.type !== "embassy",
);

const budgetStyles: Record<string, string> = {
  luxury: "bg-purple-100 text-purple-700",
  mid: "bg-blue-100 text-blue-700",
  budget: "bg-green-100 text-green-700",
};



const mapMarkers = [
  { lat: city.coordinates.lat, lng: city.coordinates.lng, name: city.nameEn },
  ...city.attractions
    .filter((a: any) => a.coordinates)
    .map((a: any) => ({ lat: a.coordinates.lat, lng: a.coordinates.lng, name: a.nameEn })),
  ...city.restaurants
    .filter((r: any) => r.coordinates)
    .map((r: any) => ({ lat: r.coordinates.lat, lng: r.coordinates.lng, name: r.nameEn })),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  meta={{
    keywords,
    canonicalUrl: `https://chinaengage.org/city/${city.slug}`,
  }}
  lang={lang}
>
  <!-- SEO: JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(citySchema)} />
  {attractionSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  {restaurantSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- SEO: hreflang for multi-language support -->
  <link rel="alternate" hreflang="en" href={enCityUrl} />
  <link rel="alternate" hreflang="ja" href={jaCityUrl} />
  <link rel="alternate" hreflang="zh-CN" href={zhCityUrl} />
  <link rel="alternate" hreflang="x-default" href={enCityUrl} />
  <!-- Hero Section -->
  <section class="relative h-80 md:h-96 bg-gradient-to-br from-blue-600 to-purple-600">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-t from-black/60 to-transparent"></div>
    </div>
    <div class="container-custom relative h-full flex flex-col justify-end pb-8">
      <!-- Breadcrumb -->
      <nav class="mb-4">
        <a href={`${langPrefix}/`} class="text-blue-200 hover:text-white transition-colors" data-i18n="nav.home">{_lookup("nav.home")}</a>
        <span class="text-blue-300 mx-2">/</span>
        <a href={`${langPrefix}/#cities`} class="text-blue-200 hover:text-white transition-colors" data-i18n="nav.cities">{_lookup("nav.cities")}</a>
        <span class="text-blue-300 mx-2">/</span>
        <span class="text-white">{localCityName}</span>
      </nav>

      <h1 class="text-4xl md:text-5xl font-bold text-white mb-2 flex items-center gap-3">
        {localCityName}
        <CityTierBadge tier={S_TIER_CITIES[city.slug]?.tier || "D"} size="md" showLabel={false} />
      </h1>
      <p class="text-xl text-blue-200 mb-4">{localCityName}</p>
      <p class="text-gray-300 max-w-2xl" data-translate={i18nCity?.description || city.description}>{isJapanese ? (i18nCity?.description || city.description) : city.description}</p>
    </div>
  </section>

  <!-- Quick Stats + Weather Bar -->
  <section class="bg-white border-b">
    <div class="container-custom py-6">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="text-center">
          <div class="text-2xl font-bold text-gray-900">{city.population}</div>
          <div class="text-sm text-gray-500" data-i18n="cityPage.population">{_lookup("cityPage.population")}</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-gray-900">{city.climate.type}</div>
          <div class="text-sm text-gray-500" data-i18n="cityPage.climate">{_lookup("cityPage.climate")}</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-gray-900">{city.attractions.length}</div>
          <div class="text-sm text-gray-500" data-i18n="cityPage.attractionsLabel">{_lookup("cityPage.attractionsLabel")}</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-gray-900">{city.restaurants.length}</div>
          <div class="text-sm text-gray-500" data-i18n="cityPage.restaurantsLabel">{_lookup("cityPage.restaurantsLabel")}</div>
        </div>
        <div class="text-center col-span-2 md:col-span-1">
          <WeatherWidget
            city={city.nameEn}
            lat={city.coordinates.lat}
            lng={city.coordinates.lng}
            lang={lang}
            i18n={weatherI18n}
            client:only="react"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Tabs -->
  <nav class="sticky top-16 z-40 bg-white border-b shadow-sm">
    <div class="container-custom">
      <div class="flex overflow-x-auto py-2 gap-1 md:gap-2">
        {modules.map(mod => (
          <a
            href={`#${mod.id}`}
            class={`flex items-center gap-1 px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors ${mod.colorClass}`}
          >
            <span>{mod.icon}</span>
            <span>{mod.label()}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="container-custom py-8">
    <div class="space-y-12">
        <!-- Overview Section -->
        <section id="overview" class="scroll-mt-32">
          <h2 class="section-title flex items-center gap-3">
            <span class="text-2xl">📍</span> <span data-i18n="cityPage.tabOverview" data-i18n-vars={JSON.stringify({ city: localCityName })}>{_lookup("cityPage.tabOverview")}</span>
          </h2>

          <!-- Hero Image -->
          <div class="rounded-2xl overflow-hidden mb-6 relative group">
            <img
              src={city.coverImage}
              alt={`${localCityName} cityscape`}
              class="w-full h-64 md:h-80 object-cover transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent" />
            <div class="absolute bottom-4 left-4 right-4">
              <div class="flex flex-wrap gap-2">
                {city.highlights.slice(0, 3).map(h => (
                  <span class="px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-medium text-gray-800">
                    {h.split(' - ')[0]}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Interactive City Map -->
          <div class="mb-6">
            <CityMap city={city} activeTab="overview" height="400px" lang={lang} client:visible />
          </div>

          <!-- Best Time to Visit -->
          <div class="bg-blue-50 rounded-xl p-6 mb-6">
          <h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
              <span aria-hidden="true">🌤</span> <span data-i18n="cityPage.bestTimeHeading" data-i18n-vars={JSON.stringify({ city: localCityName })}>{_lookup("cityPage.bestTimeHeading")}</span>
            </h3>
            <p class="text-gray-700 mb-3">{city.climate.tips}</p>
            <div class="flex flex-wrap gap-2">
              {city.climate.bestMonths.map(month => (
                <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">
                  {month}
                </span>
              ))}
            </div>
            <div class="grid grid-cols-2 gap-4 mt-4 text-sm">
              <div>
                <span class="font-medium text-gray-700" data-i18n="cityPage.summer" data-i18n-vars={JSON.stringify({ city: localCityName })}>{_lookup("cityPage.summer")}</span>
                <span class="text-gray-600 ml-2">{city.climate.avgSummerTemp}</span>
              </div>
              <div>
