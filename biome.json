{
  "$schema": "https://biomejs.org/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [".astro/**",".supabase-cache/**",".wrangler/**","dist/**","node_modules/**",".cache/**",".e2e-*.mjs",".i18n-patch.mjs",".patch-*.mjs",".seo-*.log",".e2e-*.log",".typecheck*.log",".lint*.log",".build.log",".i18n-*.mjs",".add-*.mjs",".wire-*.mjs",".fix-*.mjs",".build-*.mjs",".inject-*.mjs",".replacements.json",".emergency-*.json"]
  },
  "organizeImports": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "noAccessKey": "off",
        "useButtonType": "off",
        "useAltText": "off",
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useOptionalChain": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "jsxRuntime": "reactClassic"
  },
  "overrides": [
    {
      "include": ["**/*.astro", "node_modules/**", "dist/**"],
      "linter": {
        "rules": {
          "recommended": false,
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "include": ["**/*.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
