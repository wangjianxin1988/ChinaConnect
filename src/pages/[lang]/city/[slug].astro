          <h2 class="section-title flex items-center gap-3">
            <span class="text-2xl">🚨</span> <span data-i18n="cityPage.sectionEmergency" data-i18n-vars={JSON.stringify({ city: localCityName })}>{_lookup("cityPage.sectionEmergency")}</span>
            <span class="text-sm font-normal text-gray-500 ml-2">({city.emergencyContacts.length} {ct(lang, "unit_contacts", "contacts")})</span>
          </h2>
          <p class="section-subtitle">{_lookup("cityPage.emergencySubtitleDynamic")}</p>

          <EmergencySection contacts={city.emergencyContacts} city={city} lang={lang} client:visible />
          <AIRecommendation
            lang={lang}
            topic="emergency"
            topicLabel={_lookup("cityPage.sectionEmergency")}
            cityName={localCityName}
            citySlug={city.slug}
          />
        </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
// Real-time weather widget via OpenMeteo (free, no API key needed)
document.querySelectorAll('[id^="weather-widget-"]').forEach(widget => {
  const el = widget;
  const lat = el.dataset.lat;
  const lng = el.dataset.lng;
  if (!lat || !lng) return;

  const API = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current_weather=true&temperature_unit=fahrenheit`;
  fetch(API)
    .then(r => r.json())
    .then(data => {
      if (!data.current_weather) return;
      const w = data.current_weather;
      const tempC = Math.round((w.temperature - 32) * 5 / 9);
      const codes = {0:'☀',1:'🌤',2:'⛅',3:'☁',45:'🌫',48:'🌫',51:'🌦',53:'🌦',55:'🌧',61:'🌧',63:'🌧',65:'🌧',71:'🌨',73:'❄',75:'❄',80:'🌦',81:'🌦',82:'⛈',95:'⛈',96:'⛈',99:'⛈'};
      const icon = codes[w.weathercode] || '❓';
      el.innerHTML = `<div class="text-2xl font-bold text-gray-900">${tempC}¡ãC</div><div class="text-sm text-gray-500">${icon} {ct(lang,"weather_now","Now")}</div>`;
    })
    .catch(() => {
      el.innerHTML = `<div class="text-gray-400 text-sm" data-i18n="cityPage.weatherNA">Weather N/A</div>`;
    });
});
</script>
