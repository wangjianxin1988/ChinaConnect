---
export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"];
  const ids = getAllRestaurantIds();
  return langs.flatMap((lang) => ids.map((id) => ({ params: { lang, id } })));
}

import RestaurantDetail from "@/components/food/RestaurantDetail";
import { getAllRestaurantIds, resolveRestaurant, getSameCityRestaurants } from "@/data/food/resolve";
import { JA_FOOD_OVERRIDES } from "@/data/food/ja-food-overrides";
import { EN_FOOD_OVERRIDES } from "@/data/food/en-food-overrides";
import BaseLayout from "@/layouts/BaseLayout.astro";



const { id, lang: paramLang } = Astro.params;
const lang = (paramLang as string) || "en";
const restaurant = resolveRestaurant(id as string, lang);

if (!restaurant) {
  return Astro.redirect("/food");
}

const legacySource = restaurant.source === "legacy";
const localCityName = restaurant.cityName;
const sameCityRestaurants = getSameCityRestaurants(id as string, lang, 4);

const TYPE_CONFIG: Record<string, { label: string; labelEn: string; labelJa: string; icon: string; color: string }> = {
  michelin: { label: "米其林", labelEn: "Michelin", labelJa: "ミシュラン", icon: "⭐", color: "text-[#1E3A5F]" },
  blackpearl: {
    label: "黑珍珠",
    labelEn: "Black Pearl", labelJa: "ブラックパール",
    icon: "💎",
    color: "text-[#2D1B4E]",
  },
  local: { label: "本地推荐", labelEn: "Local", labelJa: "地元のおすすめ", icon: "🔥", color: "text-[#B8383D]" },
  default: { label: "精选", labelEn: "Featured", labelJa: "おすすめ", icon: "🍽️", color: "text-gray-700" },
};

const config = TYPE_CONFIG[restaurant.type] || TYPE_CONFIG.default;

const showTitleCn = lang === "zh-CN" || lang === "zh-TW";

// Full 12-language display dictionaries (proper nouns kept in native script)
const TYPE_LABELS: Record<string, Record<string, string>> = {
  michelin: { en: "Michelin", ja: "ミシュラン", ko: "미쉐린", "zh-CN": "米其林", "zh-TW": "米其林", th: "มิชลิน", vi: "Michelin", ru: "Мишлен", fr: "Michelin", de: "Michelin", ar: "ميشلان", fa: "میشلن" },
  blackpearl: { en: "Black Pearl", ja: "ブラックパール", ko: "블랙 펄", "zh-CN": "黑珍珠", "zh-TW": "黑珍珠", th: "แบล็กเพิร์ล", vi: "Black Pearl", ru: "Чёрная жемчужина", fr: "Black Pearl", de: "Black Pearl", ar: "اللؤلؤة السوداء", fa: "مروارید سیاه" },
  local: { en: "Local", ja: "地元のおすすめ", ko: "현지 추천", "zh-CN": "本地推荐", "zh-TW": "在地推薦", th: "ร้านท้องถิ่นแนะนำ", vi: "Địa phương", ru: "Местное", fr: "Local", de: "Lokal", ar: "محلي", fa: "محلی" },
};
const STAR_SUFFIX: Record<string, string> = { en: "-star", ja: "つ星", ko: "성급", "zh-CN": "星", "zh-TW": "星", th: "ดาว", vi: "sao", ru: " звезды", fr: " étoile", de: " Sterne", ar: " نجوم", fa: " ستاره" };
const DIAMOND_SUFFIX: Record<string, string> = { en: " diamond", ja: "ダイヤ", ko: "다이아몬드", "zh-CN": "钻", "zh-TW": "鑽", th: "เพชร", vi: "kim cương", ru: " бриллиант", fr: " diamant", de: " Diamant", ar: " ألماسة", fa: " الماس" };
const TITLE_SUFFIX: Record<string, string> = { en: "Food Recommendation", ja: "おすすめグルメ", ko: "추천 맛집", "zh-CN": "美食推荐", "zh-TW": "美食推薦", th: "ร้านอาหารแนะนำ", vi: "Ẩm thực gợi ý", ru: "Рекомендуемый ресторан", fr: "Restaurant recommandé", de: "Empfohlener Restaurantführer", ar: "مطعم موصى به", fa: "رستوران پیشنهادی" };

const jaFood = (t: string | undefined): string =>
  lang === "ja" && t ? JA_FOOD_OVERRIDES[t] || t : (t || "");
const enFood = (t: string | undefined): string =>
  lang === "en" && t ? EN_FOOD_OVERRIDES[t] || t : (t || "");
const displayFood = (t: string | undefined): string => {
  if (!t) return "";
  if (!legacySource) return t;
  return lang === "en" ? enFood(t) : jaFood(t);
};

const restaurantDetail = {
  id: restaurant.id,
  name: restaurant.name,
  name_en: lang === "en" ? "" : restaurant.nameEn,
  cuisine: displayFood(restaurant.cuisine),
  rating: restaurant.rating,
  review_count: 0,
  avg_cost: restaurant.avgPrice,
  address: displayFood(restaurant.address),
  address_zh: lang === "en" ? "" : restaurant.addressEn,
  images: restaurant.imageUrl ? [restaurant.imageUrl] : [],
  tags: (restaurant.tags || []).map((t) => displayFood(t)),
  michelin_stars: restaurant.star,
  heizhenzhu_rank: restaurant.diamond,
  blogger_recommended: !!restaurant.bloggerName,
  blogger_name: displayFood(restaurant.bloggerName),
  opening_hours: restaurant.hours ? { regular: displayFood(restaurant.hours) } : undefined,
  avg_meal_duration: 60,
  booking_required: false,
  phone: restaurant.phone,
  description: displayFood(restaurant.description),
  description_zh: lang === "en" ? "" : restaurant.descriptionEn,
};
---

<BaseLayout title={`${restaurant.name} - ${TITLE_SUFFIX[lang] || TITLE_SUFFIX.en}`}>
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <!--FOOD_HEADER_START-->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href={`/${lang}/city/${restaurant.citySlug}/food/`} class="flex items-center gap-2 text-gray-600 hover:text-gray-900">
            <span aria-hidden="true">←</span>
            <span data-i18n="foodPage.back" data-i18n-vars={JSON.stringify({ city: localCityName })}>Back</span>
          </a>
          <span class={`text-sm font-medium ${config.color}`}>
            {config.icon} {TYPE_LABELS[restaurant.type]?.[lang] || config.labelEn}
            {restaurant.type === 'michelin' && restaurant.star && `${restaurant.star}${STAR_SUFFIX[lang] || "-star"}`}
            {restaurant.type === 'blackpearl' && restaurant.diamond && `${restaurant.diamond}${DIAMOND_SUFFIX[lang] || " diamond"}`}
          </span>
        </div>
      </div>
    </header>
    <!--FOOD_HEADER_END-->

    <main class="max-w-4xl mx-auto px-4 py-6">
      <!-- Restaurant Detail with Favorites and Reviews -->
      <!--FOOD_ISLAND_START-->
      <RestaurantDetail restaurant={restaurantDetail} lang={lang} client:load />
      <!--FOOD_ISLAND_END-->

      {/* Similar Restaurants */}
      <!--FOOD_SAMECITY_START-->
      {sameCityRestaurants.length > 0 && (
        <div class="bg-white rounded-xl shadow-md p-6 mt-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4" data-i18n="foodPage.otherRestaurants" data-i18n-vars={JSON.stringify({ city: localCityName })}>Other restaurants nearby</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {sameCityRestaurants.map(r => (
              <a href={`/${lang}/food/${r.id}`} class="block group">
                {r.imageUrl && (
                  <div class="h-24 rounded-lg overflow-hidden mb-2">
                    <img src={r.imageUrl} alt={displayFood(r.name)} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                  </div>
                )}
                <p class="font-medium text-gray-900 text-sm line-clamp-1">{displayFood(r.name)}</p>
                <p class="text-xs text-gray-500">{displayFood(r.cuisine)}</p>
              </a>
            ))}
          </div>
        </div>
      )}
      <!--FOOD_SAMECITY_END-->
    </main>

    {/* Footer */}
    <footer class="bg-white border-t border-gray-200 mt-12">
      <div class="max-w-4xl mx-auto px-4 py-6 text-center text-sm text-gray-500">
        <p data-i18n="foodPage.metaFooter">ChinaConnect food recommendations</p>
      </div>
    </footer>
  </div>
</BaseLayout>
