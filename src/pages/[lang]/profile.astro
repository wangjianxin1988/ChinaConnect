---
// Personal center page removed — redirect to the account page (keeps language prefix).
export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"] as const;
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang || "en";
const target = lang === "en" ? "/account" : "/" + lang + "/account";
return Astro.redirect(target, 301);
---
