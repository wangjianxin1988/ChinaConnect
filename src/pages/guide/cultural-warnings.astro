---

import CulturalWarningsClient from "@/components/Guide/CulturalWarningsClient";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { translations } from "@/i18n/translations";

const pageTitle = translations.en.guidePage?.culturalWarningsTitle || "Cultural Warnings - ChinaConnect";
const pageDescription = translations.en.guidePage?.culturalWarningsDescription || "Navigate cultural differences and avoid common faux pas while traveling in China.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <a href="/" class="text-primary hover:underline mb-4 inline-block" data-i18n="guidePage.backHome">← Back to Home</a>
      <h1 class="text-4xl font-bold text-foreground" data-i18n="guidePage.culturalWarningsTitleShort">Cultural Warnings</h1>
      <p class="text-muted-foreground mt-2 text-lg" data-i18n="guidePage.culturalWarningsSubtitle">
        文化冲击预警 - Navigate cultural differences and avoid faux pas
      </p>
    </div>

    <CulturalWarningsClient client:load />
  </main>
</BaseLayout>
