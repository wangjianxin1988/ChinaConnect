---

export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"];
  return langs.map((lang) => ({ params: { lang } }));
}

import { getCityData } from "@/data/cities-i18n";
import { citySlugs } from "@/data/cities/index";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { translations } from "@/i18n/translations";
import { ct } from "@/i18n/components-strings";

const lang = (Astro.params.lang as string) || "en";
const localizedCities = citySlugs.map((slug) => getCityData(slug, lang)).filter(Boolean);

const pageTitle = (translations[lang] || translations.en).guidePage?.attractionsTitle || "Top Attractions in China - ChinaConnect";
const pageDescription = (translations[lang] || translations.en).guidePage?.attractionsDescription || "Discover top-rated attractions across China with opening hours, tickets, and local tips";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  meta={{
    keywords: ['China attractions', 'tourist spots', 'things to do', 'sightseeing'],
  }}
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold" data-i18n="guide.attractionsPageTitle">Top Attractions in China</h1>
      <p class="text-gray-600" data-i18n="guidePage.attractionsSubtitle">Discover the most amazing attractions across 12 Chinese cities</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {localizedCities.map((city: any) => (
        <a
          href={`/${lang}/city/${city.slug}#attractions`}
          class="group bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow block"
        >
          <div class="flex items-center gap-3 mb-3">
            <div class={`w-10 h-10 rounded-lg bg-gradient-to-br ${
              city.slug === 'beijing' ? 'from-blue-500 to-purple-600' :
              city.slug === 'shanghai' ? 'from-purple-500 to-pink-600' :
              city.slug === 'xian' ? 'from-orange-500 to-red-600' :
              'from-green-500 to-teal-600'
            } flex items-center justify-center text-white font-bold`}>
              {(city.name || city.nameEn)[0]}
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                {city.name}
              </h3>
              <p class="text-sm text-gray-500">{city.nameEn}</p>
            </div>
          </div>
          <p class="text-gray-600 text-sm">{city.description}</p>
          <div class="mt-4 flex items-center text-blue-600 text-sm font-medium">
            <span data-i18n="guidePage.viewAttractions">View Attractions</span>
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 bg-blue-50 rounded-xl p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4" data-i18n="guidePage.popularByCity">Popular Attractions by City</h2>
      <div class="grid md:grid-cols-2 gap-4 text-sm">
        <div>
          <h3 class="font-semibold text-gray-700 mb-2" data-i18n="guidePage.cityBeijing">Beijing</h3>
          <ul class="space-y-1 text-gray-600">
            <li>{ct(lang, "atx_forbidden", `• Forbidden City - Imperial palace complex`)}</li>
            <li>{ct(lang, "atx_greatwall", `• Great Wall - Iconic ancient fortification`)}</li>
            <li>{ct(lang, "atx_temple", `• Temple of Heaven - UNESCO heritage site`)}</li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-gray-700 mb-2" data-i18n="guidePage.cityShanghai">Shanghai</h3>
          <ul class="space-y-1 text-gray-600">
            <li>{ct(lang, "atx_bund", `• The Bund - Historic waterfront promenade`)}</li>
            <li>{ct(lang, "atx_yu", `• Yu Garden - Classical Chinese garden`)}</li>
            <li>{ct(lang, "atx_tower", `• Shanghai Tower - World's fastest elevator`)}</li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-gray-700 mb-2" data-i18n="guidePage.cityXian">Xi'an</h3>
          <ul class="space-y-1 text-gray-600">
            <li>{ct(lang, "atx_terracotta", `• Terracotta Warriors - Ancient army statue`)}</li>
            <li>{ct(lang, "atx_citywall", `• City Wall - Best-preserved city walls`)}</li>
            <li>{ct(lang, "atx_muslim", `• Muslim Quarter - Street food paradise`)}</li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-gray-700 mb-2" data-i18n="guidePage.cityChengdu">Chengdu</h3>
          <ul class="space-y-1 text-gray-600">
            <li>{ct(lang, "atx_panda", `• Giant Panda Base - Panda conservation`)}</li>
            <li>{ct(lang, "atx_jinli", `• Jinli Street - Traditional shopping street`)}</li>
            <li>{ct(lang, "atx_buddha", `• Leshan Giant Buddha - UNESCO heritage`)}</li>
          </ul>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
