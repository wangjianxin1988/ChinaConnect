---
import { translations } from "@/i18n/translations";
import { getLangFromUrl } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const lp = lang && lang !== "en" ? `/${lang}` : "";
---

<BaseLayout title="Page Not Found - ChinaConnect" description="The page you\'re looking for doesn\'t exist." data-i18n-title="notFound.description">
  <main class="min-h-[70vh] flex items-center justify-center bg-gray-50">
    <div class="text-center px-4">
      <div class="text-8xl mb-6">🗺️</div>
      <h1 class="text-5xl font-bold text-gray-900 mb-4"><span data-i18n="notFound.heading">404</span></h1>
      <p class="text-xl text-gray-600 mb-2"><span data-i18n="notFound.primary">Page Not Found</span></p>
      <p class="text-gray-500 mb-8 max-w-md mx-auto">
        <span data-i18n="notFound.descriptionText">The page you're looking for doesn't exist or has been moved.<br class="hidden md:block" /></span>
        <span data-i18n="notFound.letsContinue">Let's get you back on track.</span>
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`${lp}/`} class="px-6 py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700 transition-colors">
          <span data-i18n="notFound.goHome">Go Home</span>
        </a>
        <a href={`${lp}/cities`} class="px-6 py-3 bg-white border border-gray-300 text-gray-700 rounded-xl font-semibold hover:bg-gray-50 transition-colors">
          <span data-i18n="notFound.exploreCities">Explore Cities</span>
        </a>
        <a href={`${lp}/ai`} class="px-6 py-3 bg-purple-600 text-white rounded-xl font-semibold hover:bg-purple-700 transition-colors">
          <span data-i18n="notFound.askAi">Ask ChinaGuide AI</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
