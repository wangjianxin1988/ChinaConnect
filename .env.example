# ============================================
# ChinaConnect Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Supabase Configuration (Required)
# ============================================
# Replace with your actual Supabase project credentials
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: For server-side operations
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_PROJECT_ID=your-project-id

# ============================================
# MiniMax AI Configuration (Primary AI)
# ============================================
# Get your API key from: https://platform.minimaxi.com/
MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_BASE_URL=https://api.minimaxi.com

# ============================================
# Dify AI Configuration (Optional - for advanced workflows)
# ============================================
# Dify is an optional AI platform for complex workflow automation
# If not configured, the system falls back to MiniMax + ReAct engine
#
# Get your API key from: https://dify.ai/
# VITE_DIFY_API_URL=https://api.dify.ai/v1
# VITE_DIFY_API_KEY=your-dify-api-key-here
# VITE_DIFY_WORKFLOW_ID=your-workflow-id-here

# ============================================
# Amap (高德地图) API Configuration
# ============================================
# Get your API key at https://console.amap.com/dev/key/app
# VITE_AMAP_WEB_API_KEY=your-amap-web-api-key
# AnySearch provides real-time web search capabilities via MCP
# If not configured, the system uses local city database
# ANYSEARCH_API_KEY=your-anysearch-api-key
# ANYSEARCH_MCP_URL=https://api.anysearch.ai/mcp

# ============================================
# Application Settings
# ============================================
# VITE_APP_NAME=ChinaConnect
# VITE_APP_VERSION=1.0.0

# ============================================
# Flarum Forum Configuration (Optional)
# ============================================
# Flarum provides the community forum with SSO integration
# If not configured, the community page will show a setup prompt
#
# Get your Flarum URL from your deployed forum instance
# Get SSO secret from Flarum Admin > Settings > Authentication
# Get API key from Flarum Admin > Settings > API
PUBLIC_FLARUM_URL=https://forum.chinaconnect.example.com

# SSO Secret Key (generate with: openssl rand -hex 32)
FLARUM_SSO_SECRET=your-32-char-minimum-secret-key-here

# Flarum API Key (from admin panel)
FLARUM_API_KEY=your-flarum-api-key-here

# ============================================
# Creem Payment Configuration
# ============================================
# Get your API key from: https://creem.io/dashboard/developers
# Server-side only — set in Supabase Edge Function secrets
CREEM_API_KEY=creem_your-api-key-here

# Webhook signing secret — from Creem Dashboard > Developers > Webhooks
CREEM_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Set to true to use the Creem test environment (test-api.creem.io)
# CREEM_TEST_MODE=false

# Optional: Creem API base URL override (defaults to https://api.creem.io/v1)
# CREEM_BASE_URL=https://api.creem.io/v1

# Creem products are per price period, so each tier needs two product IDs.
# Create 6 products in the Creem dashboard (Explorer/Traveler/Business x
# Monthly/Yearly) and copy their IDs below.
CREEM_PRODUCT_EXPLORER_MONTHLY=prod_your_explorer_monthly_id
CREEM_PRODUCT_EXPLORER_YEARLY=prod_your_explorer_yearly_id
CREEM_PRODUCT_TRAVELER_MONTHLY=prod_your_traveler_monthly_id
CREEM_PRODUCT_TRAVELER_YEARLY=prod_your_traveler_yearly_id
CREEM_PRODUCT_BUSINESS_MONTHLY=prod_your_business_monthly_id
CREEM_PRODUCT_BUSINESS_YEARLY=prod_your_business_yearly_id

# Site URL used to build the success/cancel redirect URLs
# SITE_URL=https://chinaengage.org

# Supabase Service Role Key (needed for webhook to update user data)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
