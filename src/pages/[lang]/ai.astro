---

export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"];
  return langs.map((lang) => ({ params: { lang } }));
}

import AIChatPage from '@/components/AIChatPage';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translations } from "@/i18n/translations";
import type { Language } from "@/i18n/translations";
import { generateBreadcrumbSchema, generateJsonLdScript } from "@/lib/seo/schema-org";

const lang = (Astro.params.lang as string) || "en";
const pageTitle = translations[lang]?.aiPage?.title || translations.en.aiPage?.title || "ChinaGuide AI - Your Intelligent China Travel Expert";
const pageDescription =
  translations[lang]?.aiPage?.description || translations.en.aiPage?.description || "Your personal China travel intelligence.";

// Schema.org JSON-LD for AI page
const aiSchemas = [
  generateBreadcrumbSchema([
    { name: "Home", url: "https://chinaengage.org/" },
    { name: "AI Assistant", url: "https://chinaengage.org/ai" },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  meta={{
    noIndex: false,
  }}
>
  <!-- Schema.org JSON-LD for SEO/GEO -->
  <script type="application/ld+json" set:html={generateJsonLdScript(aiSchemas)} />

  <AIChatPage client:only="react" />
</BaseLayout>