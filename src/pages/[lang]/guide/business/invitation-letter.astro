---

export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"];
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang as string) || "en";


import InvitationLetterClient from "@/components/Guide/InvitationLetterClient";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { translations } from "@/i18n/translations";
import { getLangFromUrl } from '@/i18n/utils';
---

<BaseLayout
  title={(translations[lang] || translations.en).businessGuidePage?.invitationTitle || "Business Invitation Letter Templates - ChinaConnect"}
  description={(translations[lang] || translations.en).businessGuidePage?.invitationDescription || "Download ready-to-use bilingual invitation letter templates for China visa applications and business visits. Fill in the fields and download instantly."}
  meta={{
    keywords: ['China business visa invitation letter', 'Chinese invitation letter template', 'Business Invitation Letters', 'visa invitation China'],
  }}
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <a href={`/${lang}/guide`} class="text-primary hover:underline mb-4 inline-block flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span data-i18n="businessGuidePage.backToGuide">← Back to Travel Guide</span>
      </a>
      <div class="flex items-center gap-3 mb-3">
        <span class="text-4xl">✉️</span>
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-foreground" data-i18n="businessGuidePage.invitationShort">Business Invitation Letters</h1>
          <p class="text-muted-foreground text-lg" data-i18n="businessGuidePage.invitationSubtitle">Business Invitation Letters</p>
        </div>
      </div>
      <p class="text-muted-foreground max-w-2xl" data-i18n="businessGuidePage.invitationDescription">Ready-to-use invitation letter templates for visa applications, trade visits, and business meetings.
        Available in bilingual, English-only, and simplified formats.</p>
    </div>

    <InvitationLetterClient client:load lang={lang} />
  </main>
</BaseLayout>