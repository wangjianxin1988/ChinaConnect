---
import { UserProfilePage } from '@/components/user/UserProfilePage';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translations } from "@/i18n/translations";
import type { Language } from "@/i18n/translations";
export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"] as const;
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang as Language) || "en";

// Auth is handled client-side (static). The profile page renders a loading
// state and checks auth via client JS, mirroring the /account page.
---

<BaseLayout title={(translations[lang]?.profilePage?.title) || translations.en.profilePage?.title || "My Profile - ChinaConnect"}>
  <main class="container mx-auto px-4 py-8">
    <UserProfilePage isOwnProfile={true} client:load />
  </main>
</BaseLayout>
