---

import "@/styles/global.css";
import { citySlugs, getAdjacentCities, getCityBySlug } from "@/data/cities/index";
import { getCityData } from "@/data/cities-i18n";
import type { Restaurant } from "@/data/cities/types";
import { getLangFromUrl } from "@/i18n/utils";
import { translations } from "@/i18n/translations";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return citySlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const city = getCityData(slug as string, lang) || getCityBySlug(slug as string);

if (!city) {
  return Astro.redirect("/404");
}

const { prev, next } = getAdjacentCities(slug as string);
const localCityName = translations[lang]?.["city." + city.slug + ".name"] ?? translations.en?.["city." + city.slug + ".name"] ?? city.nameEn;

// Three-level filter from URL param
const filterParam = Astro.url.searchParams.get("filter") || "all";

// ─── Unified Restaurant Category System ──────────────────────────
// Single source of truth in src/data/food/categories.ts
import { CATEGORY_CONFIG, buildFilterGroups, getHighlightCategory, type FilterGroup } from "@/data/food/categories";

const allRestaurants = city.restaurants;
const filterGroups: FilterGroup[] = buildFilterGroups(allRestaurants);
const currentFilter = filterGroups.find(g => g.id === filterParam) || filterGroups[0];

const pageTitle = (translations[lang] || translations.en).cityFood?.title?.replace("{city}", localCityName) + " - ChinaConnect" ?? "Restaurants in " + localCityName + " - ChinaConnect";
const pageDescription = `${city.nameEn} (${city.name}) Food Guide: complete Michelin, Black Pearl, and local picks`;

function getBadgeClass(type: Restaurant["type"]) {
  if (type === "michelin") return "badge-michelin";
  if (type === "blackpearl") return "badge-blackpearl";
  return "badge-local";
}

function getBadgeLabel(type: Restaurant["type"]) {
  if (type === "michelin") return "Michelin";
  if (type === "blackpearl") return "Black Pearl";
  return "Local Favorite";
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  meta={{
    keywords: [city.nameEn, city.name, `${city.nameEn} food`, `${city.nameEn} restaurants`, "Michelin", "Black Pearl", "local food"],
  }}
  lang={lang}
>
  <!-- Hero Section -->
  <section class="relative h-64 bg-gradient-to-br from-orange-500 to-red-600">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-t from-black/60 to-transparent"></div>
    </div>
    <div class="container-custom relative h-full flex flex-col justify-end pb-8">
      <!-- Breadcrumb -->
      <nav class="mb-4">
        <a href="/" class="text-orange-200 hover:text-white transition-colors" data-i18n="cityPage.home">Home</a>
        <span class="text-orange-300 mx-2">/</span>
        <a href={`/city/${city.slug}`} class="text-orange-200 hover:text-white transition-colors">{city.nameEn}</a>
        <span class="text-orange-300 mx-2">/</span>
        <span class="text-white" data-i18n="cityPage.foodHeading">Food</span>
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2 flex items-center gap-3">
        <span>🍜</span> <span data-i18n="foodPage.heroCityFood">{city.nameEn} Food</span>
      </h1>
      <p class="text-orange-100" data-i18n="foodPage.cityEmptySubtitle">Discover Michelin, Black Pearl, and locally loved picks</p>

      <!-- Quick stats (dynamic from filterGroups) -->
      <div class="flex flex-wrap items-center gap-4 mt-4 text-sm text-orange-100">
        {filterGroups.filter(g => g.id !== 'all').slice(0, 5).map(group => {
          const statLabel = group.labels?.[lang] || group.label;
          return (
          <span class="flex items-center gap-1">
            <span>{group.icon}</span> <span>{group.restaurants.length}</span> {statLabel}
          </span>
          )})}
      </div>
    </div>
  </section>

  <div class="container-custom py-8">
    <!-- Filter Navigation -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2" id="filter-buttons">
        {filterGroups.map((group) => {
          const isActive = group.id === currentFilter.id;
          const filterLabel = group.labels?.[lang] || group.label;
          return (
            <button
              data-filter={group.id}
              data-filter-icon={group.icon}
              data-filter-label={group.labelZh}
              data-city-slug={city.slug}
              class={`
                flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold border transition-all filter-btn
                ${isActive
                  ? `${group.colorClass} ring-2 ring-offset-1 ${group.id === "blackpearl" ? "ring-slate-400" : "ring-orange-300"}`
                  : "bg-white border-gray-200 text-gray-500 hover:border-gray-300 hover:text-gray-700"
                }
              `}
            >
              <span>{group.icon}</span>
              <span>{filterLabel}</span>
              <span class={`text-xs rounded-full px-2 py-0.5 ${isActive ? "bg-white/40" : "bg-gray-100"}`}>
                {group.restaurants.length}
              </span>
            </button>
          );
        })}
      </div>

      <!-- Current filter info -->
      <div class="mt-4 flex items-center justify-between">
        <p class="text-gray-600 text-sm">
          <span class="font-semibold text-gray-900" id="restaurant-count">{currentFilter.restaurants.length}</span> <span data-i18n="foodPage.restaurantsUnit">restaurants</span>
          <span id="filter-info" class="ml-2">
            {currentFilter.id !== "all" && (
              <span>
                <span data-i18n="foodPage.filteringLabel">Filtering:</span> <span class="font-medium text-orange-600">{currentFilter.icon} {currentFilter.labels?.[lang] || currentFilter.label}</span>
              </span>
            )}
          </span>
        </p>
        <a
          href={`/city/${city.slug}`}
          class="text-sm text-blue-600 hover:text-blue-700 font-medium hover:underline flex items-center gap-1"
        >
          <span>←</span> <span data-i18n="foodPage.backToCity">Back to {city.nameEn}</span>
        </a>
      </div>
    </div>

    <!-- Restaurant Grid -->
    {allRestaurants.length > 0 ? (
      <div id="restaurant-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-current-filter="all">
        {allRestaurants.map((restaurant) => (
          <div
            data-filter-category={getHighlightCategory(restaurant)}
            class="bg-white border border-gray-100 rounded-xl overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all group restaurant-card"
          >
            {/* Restaurant Image */}
            {restaurant.imageUrl && (
              <div class="h-40 overflow-hidden">
                <img
                  src={restaurant.imageUrl}
                  alt={restaurant.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-5">
            {/* Header - clickable link to detail */}
            <a href={`/food/${restaurant.id}`} class="block mb-3">
              <div class="flex items-start justify-between gap-2">
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-semibold text-gray-900 leading-tight group-hover:text-blue-600 transition-colors">
                    {restaurant.nameEn}
                  </h3>
                  <p class="text-gray-500 text-sm truncate">{restaurant.name}</p>
                </div>
                {/* Highlight badges */}
                <div class="shrink-0 flex flex-col gap-1 items-end">
                  {restaurant.type === "michelin" && restaurant.star && (
                    <div class="flex items-center gap-0.5">
                      {Array.from({ length: restaurant.star }).map((_, i) => (
                        <span key={i} class="text-amber-400 text-sm">★</span>
                      ))}
                    </div>
                  )}
                  {restaurant.type === "blackpearl" && restaurant.diamond && (
                    <div class="flex items-center gap-0.5">
                      {Array.from({ length: restaurant.diamond }).map((_, i) => (
                        <span key={i} class="text-gray-400 text-sm">◆</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </a>

            {/* Type badge */}
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${getBadgeClass(restaurant.type)}`}>
                {getBadgeLabel(restaurant.type)}
                {restaurant.type === "michelin" && restaurant.star ? `${restaurant.star}-star` : ""}
                {restaurant.type === "blackpearl" && restaurant.diamond ? `${restaurant.diamond}-diamond` : ""}
              </span>
              <span class="text-gray-500 text-sm">{restaurant.cuisine}</span>
              {restaurant.hours && (
                <>
                  <span class="text-gray-300">|</span>
                  <span class="text-gray-500 text-sm">{restaurant.hours}</span>
                </>
              )}
            </div>

            {/* Price & Rating */}
            <div class="flex items-center gap-4 mb-3 text-sm">
              <div>
                <span class="text-gray-500">¥</span>
                <span class="font-semibold text-gray-900">{restaurant.avgPrice}</span>
                <span class="text-gray-400" data-i18n="foodPage.perPerson">/person</span>
              </div>
              {restaurant.rating && (
                <div class="text-yellow-500 font-medium">★ {restaurant.rating}</div>
              )}
            </div>

            {/* Description */}
            {restaurant.description && (
              <p class="text-gray-600 text-sm leading-relaxed mb-3 line-clamp-2">
                {restaurant.description}
              </p>
            )}

            {/* Signature dishes */}
            {restaurant.dishHighlights && restaurant.dishHighlights.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mb-3">
                {restaurant.dishHighlights.slice(0, 3).map((dish, i) => (
                  <span
                    key={i}
                    class="px-2.5 py-1 bg-red-50 text-red-700 rounded-full text-xs font-medium"
                  >
                    {dish}
                  </span>
                ))}
              </div>
            )}

            {/* Tags */}
            {restaurant.tags && restaurant.tags.length > 0 && (
              <div class="flex flex-wrap gap-1 mb-3">
                {restaurant.tags.slice(0, 4).map((tag) => (
                  <span key={tag} class="px-2 py-0.5 bg-gray-50 text-gray-600 rounded text-xs">
                    #{tag}
                  </span>
                ))}
              </div>
            )}

            {/* Action row - phone and map buttons now properly inside card */}
            <div class="flex items-center gap-2 pt-3 border-t border-gray-100 flex-wrap">
              {restaurant.phone && (
                <a
                  href={`tel:${restaurant.phone.replace(/\s/g, "")}`}
                  class="flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 text-blue-700 rounded-lg text-sm font-medium hover:bg-blue-100 transition-colors shrink-0"
                >
                  <span>📞</span>
                  <span data-i18n="foodPage.callPhone">Call</span>
                </a>
              )}
              {restaurant.coordinates?.lat && restaurant.coordinates?.lng ? (
                <>
                  <a
                    href={`https://uri.amap.com/marker?position=${restaurant.coordinates.lng},${restaurant.coordinates.lat}&name=${encodeURIComponent(restaurant.name)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 px-3 py-1.5 bg-green-50 text-green-700 rounded-lg text-sm font-medium hover:bg-green-100 transition-colors shrink-0"
                  >
                    <span>🗺️</span>
                    <span data-i18n="foodPage.amapNav">Amap</span>
                  </a>
                  <a
                    href={`https://maps.google.com/maps?search=${restaurant.coordinates.lat},${restaurant.coordinates.lng}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg text-sm font-medium hover:bg-emerald-100 transition-colors shrink-0"
                  >
                    <span>🌍</span>
                    <span><span data-i18n="cityFood.googleMaps">Google Maps</span></span>
                  </a>
                </>
              ) : restaurant.address ? (
                <a
                  href={`https://uri.amap.com/search?keyword=${encodeURIComponent(restaurant.address)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 px-3 py-1.5 bg-green-50 text-green-700 rounded-lg text-sm font-medium hover:bg-green-100 transition-colors shrink-0"
                >
                  <span>🗺️</span>
                  <span data-i18n="foodPage.navigate">Navigate</span>
                </a>
              ) : null}
              <span class="text-xs text-gray-400 truncate max-w-[200px]" title={restaurant.address}>
                {restaurant.address}
              </span>
            </div>
            </div>{/* end p-5 inner div */}
          </div>
        ))}
      </div>
    ) : (
      <!-- Empty state -->
      <div id="empty-state" class="text-center py-16">
        <div class="text-6xl mb-4">🍽️</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2" data-i18n="foodPage.emptyTitle">No restaurants yet</h3>
        <p class="text-gray-500 mb-6" data-i18n="foodPage.emptyDesc">No restaurants in this category. Try another filter.</p>
        <button
          data-filter="all"
          data-city-slug={city.slug}
          class="inline-flex items-center gap-2 px-6 py-3 bg-orange-500 text-white rounded-xl font-semibold hover:bg-orange-600 transition-colors filter-btn"
        >
          View all restaurants
        </button>
      </div>
    )}

    <!-- Reference Sources -->
    <div class="mt-12 p-6 bg-gray-50 rounded-xl border border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900 mb-3 flex items-center gap-2">
        <span>📚</span> <span data-i18n="foodPage.dataSourcesHeading">Reference Sources</span>
      </h3>
      <p class="text-sm text-gray-600 mb-4" data-i18n="foodPage.dataSourcesDesc">These sources can help you learn more about {city.name}'s food culture:</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="https://www.dianping.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200 hover:border-orange-300 hover:shadow-sm transition-all">
          <span class="text-xl">🔍</span>
          <div>
            <div class="font-medium text-gray-900 text-sm">Dianping</div>
            <div class="text-xs text-gray-500" data-i18n="cityFood.dianpingDesc">China's largest local-life service platform</div>
          </div>
        </a>
        <a href="https://www.meituan.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200 hover:border-orange-300 hover:shadow-sm transition-all">
          <span class="text-xl">🛵</span>
          <div>
            <div class="font-medium text-gray-900 text-sm">Meituan</div>
            <div class="text-xs text-gray-500" data-i18n="cityFood.meituanDesc">Food delivery & reviews platform</div>
          </div>
        </a>
        <a href="https://www.xiaohongshu.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200 hover:border-orange-300 hover:shadow-sm transition-all">
          <span class="text-xl">📕</span>
          <div>
            <div class="font-medium text-gray-900 text-sm">Xiaohongshu</div>
            <div class="text-xs text-gray-500" data-i18n="cityFood.xiaohongshuDesc">Local food exploration guides</div>
          </div>
        </a>
        <a href="https://guide.michelin.com/cn/zh_CN/restaurants" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200 hover:border-orange-300 hover:shadow-sm transition-all">
          <span class="text-xl">⭐</span>
          <div>
            <div class="font-medium text-gray-900 text-sm">Michelin Guide</div>
            <div class="text-xs text-gray-500" data-i18n="cityFood.michelinDesc">International authoritative restaurant ratings</div>
          </div>
        </a>
      </div>
    </div>

    <!-- Navigation -->
    <div class="mt-12 flex items-center justify-between border-t border-gray-100 pt-8">
      <div>
        {prev && (
          <a
            href={`/city/${prev.slug}/food`}
            class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-orange-300 hover:bg-orange-50 transition-all"
          >
            <span class="text-gray-400">←</span>
            <div>
              <div class="text-xs text-gray-500" data-i18n="cityFood.previousCity">Previous city</div>
              <div class="font-semibold text-gray-700">{prev.nameEn} Food</div>
            </div>
          </a>
        )}
      </div>
      <div>
        {next && (
          <a
            href={`/city/${next.slug}/food`}
            class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-orange-300 hover:bg-orange-50 transition-all"
          >
            <div class="text-right">
              <div class="text-xs text-gray-500" data-i18n="cityFood.nextCity">Next city</div>
              <div class="font-semibold text-gray-700">{next.nameEn} Food</div>
            </div>
            <span class="text-gray-400">→</span>
          </a>
        )}
      </div>
    </div>
  </div>

  <script>
    // City food page filter — works under both regular page load and Astro
    // view transitions. Reads filter icon / label from a data-* attribute
    // injected by the server (single source of truth), so client and server
    // never drift.
    function initFoodFilter() {
      const filterButtons = document.querySelectorAll('.filter-btn');
      const restaurantGrid = document.getElementById('restaurant-grid');
      const restaurantCount = document.getElementById('restaurant-count');
      const filterInfo = document.getElementById('filter-info');
      const emptyState = document.getElementById('empty-state');
      if (!filterButtons.length || !restaurantGrid) return;

      function getInitialFilter() {
        const params = new URLSearchParams(window.location.search);
        return params.get('filter') || 'all';
      }

      function updateURL(filter) {
        try {
          const url = new URL(window.location.href);
          if (filter === 'all') {
            url.searchParams.delete('filter');
          } else {
            url.searchParams.set('filter', filter);
          }
          history.pushState({ filter }, '', url.toString());
        } catch (e) {}
      }

      function applyFilter(filter) {
        const cards = restaurantGrid.querySelectorAll('.restaurant-card');
        let visibleCount = 0;
        cards.forEach((card) => {
          const category = card.getAttribute('data-filter-category');
          if (!filter || filter === 'all' || category === filter) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (restaurantCount) restaurantCount.textContent = String(visibleCount);

        if (filterInfo) {
          const btn = Array.from(filterButtons).find(
            (b) => b.dataset.filter === filter,
          );
          const icon = btn ? btn.getAttribute('data-filter-icon') : '';
          const labelZh = btn ? btn.getAttribute('data-filter-label') : '';
          if (filter === 'all' || !icon) {
            filterInfo.innerHTML = '';
          } else {
            filterInfo.innerHTML = '<span data-i18n="foodPage.filteringLabel">Filtering:</span> <span class="font-medium text-orange-600">' + icon + ' ' + labelZh + '</span>';
          }
        }
        if (emptyState) emptyState.style.display = visibleCount === 0 ? '' : 'none';
        if (restaurantGrid) restaurantGrid.style.display = visibleCount === 0 ? 'none' : '';

        filterButtons.forEach((btn) => {
          const isActive = btn.dataset.filter === filter;
          btn.classList.toggle('ring-2', isActive);
          btn.classList.toggle('ring-offset-1', isActive);
          if (filter === 'blackpearl') {
            btn.classList.toggle('ring-slate-400', isActive);
            btn.classList.remove('ring-orange-300');
          } else {
            btn.classList.toggle('ring-orange-300', isActive);
            btn.classList.remove('ring-slate-400');
          }
        });
      }

      applyFilter(getInitialFilter());
      filterButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const filter = btn.dataset.filter;
          if (!filter) return;
          updateURL(filter);
          applyFilter(filter);
        });
      });
      window.addEventListener('popstate', () => applyFilter(getInitialFilter()));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFoodFilter);
    } else {
      initFoodFilter();
    }
    document.addEventListener('astro:page-load', initFoodFilter);
  </script>

  <!-- Authoritative Data Sources -->
  <section class="container-custom py-8 mt-8 border-t border-gray-200">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-lg font-semibold text-gray-700 mb-3" data-i18n="cityFood.dataSourcesHeading">📊 Data Sources & References</h2>
      <div class="bg-gray-50 rounded-xl p-5 text-sm text-gray-600 space-y-2">
        <p><span data-i18n="cityFood.dataSourcesDesc">Restaurant data compiled from authoritative sources. Verify details before visiting:</span></p>
        <ul class="list-disc list-inside space-y-1 ml-2">
          <li><a href="https://www.dianping.com" target="_blank" rel="noopener" class="text-blue-600 hover:underline">Dianping (���ڵ���)</a> — China's largest restaurant review platform</li>
          <li><a href="https://www.michelin.com/en/restaurant-and-hotel/" target="_blank" rel="noopener" class="text-blue-600 hover:underline">Michelin Guide</a> — Official Michelin star ratings</li>
          <li><a href="https://www.meishij.net" target="_blank" rel="noopener" class="text-blue-600 hover:underline">Meishij (��ʳ��)</a> — Chinese cuisine database</li>
          <li><a href="https://www.ctrip.com" target="_blank" rel="noopener" class="text-blue-600 hover:underline">Ctrip / Trip.com (Я��)</a> — Travel & dining reviews</li>
          <li><a href="https://www.mafengwo.cn" target="_blank" rel="noopener" class="text-blue-600 hover:underline">Mafengwo (马蜂窝)</a> — Travel community reviews</li>
        </ul>
        <p class="text-xs text-gray-400 mt-3">data-i18n="cityFood.disclaimer"Phone numbers and addresses may change. We recommend verifying via the restaurant's official channels or calling ahead.</p>
      </div>
    </div>
  </section>
</BaseLayout>
