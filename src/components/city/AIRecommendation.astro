---
import { ct } from "@/i18n/components-strings";

interface Props {
  lang: string;
  topic: string;
  topicLabel: string;
  cityName: string;
  citySlug: string;
}

const { lang, topic, topicLabel, cityName, citySlug } = Astro.props;
const lp = lang === "en" ? "" : "/" + lang;
const prompt = ct(lang, "ai_rec_prompt", "Help me plan {topic} in {city}")
  .replace("{topic}", topicLabel)
  .replace("{city}", cityName);
const cta = ct(lang, "ai_rec_cta", "Ask the AI Assistant");
const aiUrl =
  lp + "/ai?q=" + encodeURIComponent(prompt) +
  "&topic=" + encodeURIComponent(topic) +
  "&city=" + encodeURIComponent(citySlug);
---

<!-- ChinaGuide AI usage recommendation card (SSR, no client JS) -->
<div
  class="my-6 rounded-2xl bg-gradient-to-r from-indigo-600 via-blue-600 to-purple-600 text-white p-5 flex flex-col sm:flex-row items-start sm:items-center gap-4 shadow-md"
>
  <div class="flex-1 min-w-0">
    <div class="flex flex-wrap items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/20 text-xs font-semibold">
        ✨ ChinaGuide AI
      </span>
      <span class="text-xs text-indigo-100 truncate">{topicLabel}</span>
    </div>
    <p class="font-semibold text-white leading-snug">“{prompt}”</p>
  </div>
  <a
    href={aiUrl}
    class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 bg-white text-indigo-700 rounded-xl font-semibold text-sm hover:bg-indigo-50 transition-colors shadow"
  >
    {cta}
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
    </svg>
  </a>
</div>
