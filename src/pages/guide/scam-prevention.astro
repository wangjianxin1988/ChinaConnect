---

import ScamPreventionClient from "@/components/Guide/ScamPreventionClient";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { translations } from "@/i18n/translations";

const pageTitle = translations.en.guidePage?.scamPreventionTitle || "Scam Prevention Guide - ChinaConnect";
const pageDescription = translations.en.guidePage?.scamPreventionDescription || "Protect yourself from common scams and tourist traps in China.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <a href="/" class="text-primary hover:underline mb-4 inline-block" data-i18n="guidePage.backHome">← Back to Home</a>
      <h1 class="text-4xl font-bold text-foreground" data-i18n="guidePage.scamPreventionTitleShort">Scam Prevention Guide</h1>
      <p class="text-muted-foreground mt-2 text-lg" data-i18n="guidePage.scamPreventionSubtitle">
        Scam Prevention - Protect yourself from common scams in China
      </p>
    </div>

    <ScamPreventionClient client:load />
  </main>
</BaseLayout>
