---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { translations } from "@/i18n/translations";
import type { Language } from "@/i18n/translations";

export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"] as Language[];
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang as Language) || "en";
const t = translations[lang] || translations.en;
const pageTitle = t.termsPage?.pageTitle || translations.en.termsPage?.pageTitle || "Terms of Service - ChinaConnect";
const pageDescription = t.termsPage?.pageDescription || translations.en.termsPage?.pageDescription || "The terms governing your use of ChinaConnect.";
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang}>
  <main class="bg-gray-50 min-h-screen">
    <section class="bg-gradient-to-br from-gray-700 to-gray-900 text-white py-16">
      <div class="container-custom">
        <h1 class="text-4xl font-bold mb-3" data-i18n="termsPage.pageTitle">Terms of Service</h1>
        <p class="text-gray-300" data-i18n="termsPage.lastUpdated">Last updated: August 2026</p>
      </div>
    </section>
    <section class="py-12">
      <div class="container-custom max-w-3xl">
        <p class="text-gray-700 mb-8" data-i18n="termsPage.intro">By accessing or using ChinaConnect, you agree to be bound by these Terms of Service.</p>

        <h2 class="text-2xl font-bold text-gray-900 mb-4" data-i18n="termsPage.useTitle">1. Use of Services</h2>
        <ul class="list-disc list-inside space-y-3 text-gray-700 mb-8">
          <li data-i18n="termsPage.use1">ChinaConnect provides travel guides, AI assistance, and city information for planning purposes.</li>
          <li data-i18n="termsPage.use2">You agree to use the service lawfully and not to disrupt or abuse it.</li>
          <li data-i18n="termsPage.use3">The AI assistant provides suggestions only; always verify critical travel information independently.</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mb-4" data-i18n="termsPage.contentTitle">2. Content and Accuracy</h2>
        <ul class="list-disc list-inside space-y-3 text-gray-700 mb-8">
          <li data-i18n="termsPage.content1">We strive for accuracy but travel information (prices, hours, contact details) may change. Verify before relying on it.</li>
          <li data-i18n="termsPage.content2">Restaurant, attraction, and hotel information is curated from public sources and may contain errors.</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mb-4" data-i18n="termsPage.ipTitle">3. Intellectual Property</h2>
        <ul class="list-disc list-inside space-y-3 text-gray-700 mb-8">
          <li data-i18n="termsPage.ip1">All content, trademarks, and logos on this site are owned by ChinaConnect or its licensors.</li>
          <li data-i18n="termsPage.ip2">You may not copy, reproduce, or redistribute site content without permission.</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mb-4" data-i18n="termsPage.linksTitle">4. Third-Party Links and Services</h2>
        <ul class="list-disc list-inside space-y-3 text-gray-700 mb-8">
          <li data-i18n="termsPage.links1">Our site links to third-party services (booking sites, payment apps, maps). We are not responsible for their content.</li>
          <li data-i18n="termsPage.links2">Payments and bookings made through external services are governed by those providers' terms.</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mb-4" data-i18n="termsPage.liabilityTitle">5. Limitation of Liability</h2>
        <ul class="list-disc list-inside space-y-3 text-gray-700 mb-8">
          <li data-i18n="termsPage.liability1">ChinaConnect is provided "as is" without warranties of any kind.</li>
          <li data-i18n="termsPage.liability2">We are not liable for any damages arising from your use of the site or reliance on its content.</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mb-4" data-i18n="termsPage.changesTitle">6. Changes to These Terms</h2>
        <ul class="list-disc list-inside space-y-3 text-gray-700 mb-8">
          <li data-i18n="termsPage.changes1">We may update these terms from time to time. Continued use of the site constitutes acceptance of the updated terms.</li>
        </ul>

        <h2 class="text-2xl font-bold text-gray-900 mb-4" data-i18n="termsPage.contactTitle">7. Contact</h2>
        <p class="text-gray-700" data-i18n="termsPage.contact1">Questions about these terms? Email 18801400211@163.com.</p>
      </div>
    </section>
  </main>
</BaseLayout>
