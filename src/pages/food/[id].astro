---

import RestaurantDetail from "@/components/food/RestaurantDetail";
import { cities } from "@/data/food/cities";
import { getRestaurantById, restaurants } from "@/data/food/restaurants";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLangFromUrl } from "@/i18n/utils";
import { EN_FOOD_OVERRIDES } from "@/data/food/en-food-overrides";

export function getStaticPaths() {
  return restaurants.map((r) => ({
    params: { id: r.id },
  }));
}

const { id } = Astro.params;
const restaurant = getRestaurantById(id as string);

if (!restaurant) {
  return Astro.redirect("/food");
}

const city = cities.find((c) => c.id === restaurant.city);
const sameCityRestaurants = restaurants
  .filter((r) => r.city === restaurant.city && r.id !== restaurant.id)
  .slice(0, 4);

const TYPE_CONFIG = {
  michelin: { label: "米其林", labelEn: "Michelin", icon: "⭐", stars: restaurant.star, color: "text-[#1E3A5F]" },
  blackpearl: {
    label: "黑珍珠",
    labelEn: "Black Pearl",
    icon: "💎",
    diamonds: restaurant.diamond,
    color: "text-[#2D1B4E]",
  },
  local: { label: "本地推荐", labelEn: "Local", icon: "🔥", color: "text-[#B8383D]" },
};

const config = TYPE_CONFIG[restaurant.type];

// Convert to RestaurantDetail-compatible format
const lang = getLangFromUrl(Astro.url);
const showTitleCn = lang === "zh-CN" || lang === "zh-TW";
const enFood = (t: string | undefined): string => (lang === "en" && t && EN_FOOD_OVERRIDES[t]) || t || "";

const restaurantDetail = {
  id: restaurant.id,
  name: restaurant.nameEn || restaurant.name,
  name_en: "",
  cuisine: enFood(restaurant.cuisine),
  rating: restaurant.rating,
  review_count: 0,
  avg_cost: restaurant.avgPrice,
  address: enFood(restaurant.address),
  address_zh: "",
  images: restaurant.imageUrl ? [restaurant.imageUrl] : [],
  tags: (restaurant.tags || []).map((t) => enFood(t)),
  michelin_stars: restaurant.star,
  heizhenzhu_rank: restaurant.diamond,
  blogger_recommended: !!restaurant.bloggerName,
  blogger_name: enFood(restaurant.bloggerName),
  opening_hours: restaurant.hours ? { regular: enFood(restaurant.hours) } : undefined,
  avg_meal_duration: 60,
  booking_required: false,
  phone: restaurant.phone,
  description: restaurant.descriptionEn || enFood(restaurant.description),
  description_zh: "",
};
---

<BaseLayout title={showTitleCn ? `${restaurant.name} - 美食推荐` : `${restaurant.nameEn || restaurant.name} - Food Recommendation`}>
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href={`/food?city=${restaurant.city}`} class="flex items-center gap-2 text-gray-600 hover:text-gray-900">
            <span aria-hidden="true">←</span>
            <span data-i18n="foodPage.back" data-i18n-vars={JSON.stringify({ city: city?.nameEn || restaurant.city })}>Back</span>
          </a>
          <span class={`text-sm font-medium ${config.color}`}>
            {config.icon} {showTitleCn ? config.label : config.labelEn}
            {restaurant.type === 'michelin' && restaurant.star && (showTitleCn ? `${restaurant.star}星` : `${restaurant.star}-star`)}
            {restaurant.type === 'blackpearl' && restaurant.diamond && (showTitleCn ? `${restaurant.diamond}钻` : `${restaurant.diamond}-diamond`)}
          </span>
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-6">
      <!-- Restaurant Detail with Favorites and Reviews -->
      <RestaurantDetail restaurant={restaurantDetail} client:load />

      {/* Similar Restaurants */}
      {sameCityRestaurants.length > 0 && (
        <div class="bg-white rounded-xl shadow-md p-6 mt-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4" data-i18n="foodPage.otherRestaurants" data-i18n-vars={JSON.stringify({ city: city?.nameEn || restaurant.city })}>Other restaurants nearby</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {sameCityRestaurants.map(r => (
              <a href={`/food/${r.id}`} class="block group">
                {r.imageUrl && (
                  <div class="h-24 rounded-lg overflow-hidden mb-2">
                    <img src={r.imageUrl} alt={r.nameEn || r.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                  </div>
                )}
                <p class="font-medium text-gray-900 text-sm line-clamp-1">{r.nameEn || r.name}</p>
                <p class="text-xs text-gray-500">{enFood(r.cuisine)}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </main>

    {/* Footer */}
    <footer class="bg-white border-t border-gray-200 mt-12">
      <div class="max-w-4xl mx-auto px-4 py-6 text-center text-sm text-gray-500">
        <p data-i18n="foodPage.metaFooter">ChinaConnect food recommendations</p>
      </div>
    </footer>
  </div>
</BaseLayout>
