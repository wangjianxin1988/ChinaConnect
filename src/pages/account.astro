---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountPage from '@/components/user/AccountPage.astro';
import { translations } from "@/i18n/translations";
import type { Language } from "@/i18n/translations";

const lang = (Astro.locals.lang as Language) || "en";

// Auth is handled by middleware (SSR) and client-side JS (static).
// The account page renders a loading state and checks auth via client JS.
---

<BaseLayout title={translations[lang]?.accountPage?.pageTitle ?? "My Account - ChinaConnect"}>
  <AccountPage lang={lang} />
</BaseLayout>
