---

import { getCityBySlug, citySlugs } from "@/data/cities/index";
import { getCityData } from "@/data/cities-i18n";
import { ct } from "@/i18n/components-strings";
import { translations } from "@/i18n/translations";
import AIRecommendation from "@/components/city/AIRecommendation.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cityDisplayName, entityDisplayName, entitySecondaryName, pruneCityEntityNames } from "@/lib/city-name";
import { citySourceLabel } from "@/lib/city-sources";

export function getStaticPaths() {
  const langs = ["en", "ja", "ko", "zh-CN", "zh-TW", "th", "vi", "ru", "fr", "de", "ar", "fa"] as const;
  return langs.flatMap((lang) => citySlugs.map((slug) => ({ params: { lang, slug } })));
}

const { slug, lang: paramLang } = Astro.params;
const lang = (paramLang as string) || "en";
const city = pruneCityEntityNames(
  getCityData(slug as string, lang) || getCityBySlug(slug as string),
  lang,
);

if (!city) {
  return Astro.redirect("/404");
}

const i18nCity = lang !== "en" ? getCityData(city.slug, lang) : null;
const localCityName = translations[lang]?.["city." + city.slug + ".name"] ?? translations.en?.["city." + city.slug + ".name"] ?? cityDisplayName(city, lang);
const isJapanese = lang === "ja";
const _ft = (key, vars) => {
  if (vars === undefined) vars = {};
  const parts = key.split(".");
  let cur = translations[lang] || translations.en;
  for (const k of parts) { if (cur && typeof cur === "object" && k in cur) cur = cur[k]; else return key; }
  if (typeof cur !== "string") return key;
  return cur.replace(/\{(\w+)\}/g, (m, k) => (vars && k in vars ? String(vars[k]) : ""));
};

const pageTitle = (translations[lang] || translations.en).cityAttractions?.title?.replace("{city}", localCityName) + " - ChinaConnect";
const pageDescription = ((translations[lang] || translations.en).cityAttractions?.subtitle || `${localCityName}の${city.attractions.length}件の観光スポットを探索`).replace("{city}", localCityName);

// Get unique categories
const categories = [...new Set(city.attractions.map((a: any) => a.category))].sort();
const CAT_LABELS: Record<string, Record<string, string>> = {
  adventure: { en: "Adventure", ja: "アドベンチャー", ko: "모험", "zh-CN": "探险", "zh-TW": "探險", th: "การผจญภัย", vi: "Phiêu lưu", ru: "Приключения", fr: "Aventure", de: "Abenteuer", ar: "مغامرة", fa: "ماجراجویی" },
  aquarium: { en: "Aquarium", ja: "水族館", ko: "수족관", "zh-CN": "水族馆", "zh-TW": "水族館", th: "พิพิธภัณฑ์สัตว์น้ำ", vi: "Thủy cung", ru: "Аквариум", fr: "Aquarium", de: "Aquarium", ar: "حوض أسماك", fa: "آکواریوم" },
  beach: { en: "Beach", ja: "ビーチ", ko: "해변", "zh-CN": "海滩", "zh-TW": "海灘", th: "ชายหาด", vi: "Bãi biển", ru: "Пляж", fr: "Plage", de: "Strand", ar: "شاطئ", fa: "ساحل" },
  cultural: { en: "Cultural", ja: "文化", ko: "문화", "zh-CN": "文化", "zh-TW": "文化", th: "วัฒนธรรม", vi: "Văn hóa", ru: "Культурный", fr: "Culturel", de: "Kulturell", ar: "ثقافي", fa: "فرهنگی" },
  culture: { en: "Culture", ja: "文化", ko: "문화", "zh-CN": "文化", "zh-TW": "文化", th: "วัฒนธรรม", vi: "Văn hóa", ru: "Культура", fr: "Culture", de: "Kultur", ar: "ثقافة", fa: "فرهنگ" },
  entertainment: { en: "Entertainment", ja: "エンターテイメント", ko: "연예", "zh-CN": "娱乐", "zh-TW": "娛樂", th: "บันเทิง", vi: "Giải trí", ru: "Развлечения", fr: "Divertissement", de: "Unterhaltung", ar: "ترفيه", fa: "سرگرمی" },
  family: { en: "Family", ja: "家族向け", ko: "가족", "zh-CN": "亲子", "zh-TW": "親子", th: "ครอบครัว", vi: "Gia đình", ru: "Семейный", fr: "Familial", de: "Familie", ar: "عائلي", fa: "خانوادگی" },
  festival: { en: "Festival", ja: "祭り", ko: "축제", "zh-CN": "节庆", "zh-TW": "節慶", th: "เทศกาล", vi: "Lễ hội", ru: "Фестиваль", fr: "Festival", de: "Festival", ar: "مهرجان", fa: "جشنواره" },
  historical: { en: "Historical", ja: "歴史", ko: "역사", "zh-CN": "历史", "zh-TW": "歷史", th: "ประวัติศาสตร์", vi: "Lịch sử", ru: "Исторический", fr: "Historique", de: "Historisch", ar: "تاريخي", fa: "تاریخی" },
  island: { en: "Island", ja: "島", ko: "섬", "zh-CN": "岛屿", "zh-TW": "島嶼", th: "เกาะ", vi: "Đảo", ru: "Остров", fr: "Île", de: "Insel", ar: "جزيرة", fa: "جزیره" },
  landmark: { en: "Landmark", ja: "ランドマーク", ko: "랜드마크", "zh-CN": "地标", "zh-TW": "地標", th: "สถานที่สำคัญ", vi: "Địa danh", ru: "Достопримечательность", fr: "Monument", de: "Wahrzeichen", ar: "معلم", fa: "بنای تاریخی" },
  market: { en: "Market", ja: "市場", ko: "시장", "zh-CN": "市场", "zh-TW": "市集", th: "ตลาด", vi: "Chợ", ru: "Рынок", fr: "Marché", de: "Markt", ar: "سوق", fa: "بازار" },
  modern: { en: "Modern", ja: "モダン", ko: "현대", "zh-CN": "现代", "zh-TW": "現代", th: "ทันสมัย", vi: "Hiện đại", ru: "Современный", fr: "Moderne", de: "Modern", ar: "حديث", fa: "مدرن" },
  museum: { en: "Museum", ja: "博物館", ko: "박물관", "zh-CN": "博物馆", "zh-TW": "博物館", th: "พิพิธภัณฑ์", vi: "Bảo tàng", ru: "Музей", fr: "Musée", de: "Museum", ar: "متحف", fa: "موزه" },
  natural: { en: "Natural", ja: "自然", ko: "자연", "zh-CN": "自然", "zh-TW": "自然", th: "ธรรมชาติ", vi: "Thiên nhiên", ru: "Природа", fr: "Naturel", de: "Natur", ar: "طبيعي", fa: "طبیعی" },
  nature: { en: "Nature", ja: "自然", ko: "자연", "zh-CN": "自然", "zh-TW": "自然", th: "ธรรมชาติ", vi: "Thiên nhiên", ru: "Природа", fr: "Nature", de: "Natur", ar: "طبيعة", fa: "طبیعت" },
  park: { en: "Park", ja: "公園", ko: "공원", "zh-CN": "公园", "zh-TW": "公園", th: "สวนสาธารณะ", vi: "Công viên", ru: "Парк", fr: "Parc", de: "Park", ar: "حديقة", fa: "پارک" },
  resort: { en: "Resort", ja: "リゾート", ko: "리조트", "zh-CN": "度假区", "zh-TW": "度假區", th: "รีสอร์ท", vi: "Khu nghỉ dưỡng", ru: "Курорт", fr: "Station balnéaire", de: "Resort", ar: "منتجع", fa: "تفرجگاه" },
  seasonal: { en: "Seasonal", ja: "季節限定", ko: "계절", "zh-CN": "季节性", "zh-TW": "季節性", th: "ตามฤดูกาล", vi: "Theo mùa", ru: "Сезонный", fr: "Saisonnier", de: "Saisonal", ar: "موسمي", fa: "فصلی" },
  shopping: { en: "Shopping", ja: "ショッピング", ko: "쇼핑", "zh-CN": "购物", "zh-TW": "購物", th: "ช้อปปิ้ง", vi: "Mua sắm", ru: "Шоппинг", fr: "Shopping", de: "Einkaufen", ar: "تسوق", fa: "خرید" },
  sports: { en: "Sports", ja: "スポーツ", ko: "스포츠", "zh-CN": "运动", "zh-TW": "運動", th: "กีฬา", vi: "Thể thao", ru: "Спорт", fr: "Sport", de: "Sport", ar: "رياضة", fa: "ورزش" },
  street: { en: "Street", ja: "ストリート", ko: "거리", "zh-CN": "街区", "zh-TW": "街區", th: "ถนน", vi: "Phố", ru: "Улица", fr: "Rue", de: "Straße", ar: "شارع", fa: "خیابان" },
  temple: { en: "Temple", ja: "寺院", ko: "사찰", "zh-CN": "寺庙", "zh-TW": "寺廟", th: "วัด", vi: "Chùa", ru: "Храм", fr: "Temple", de: "Tempel", ar: "معبد", fa: "معبد" },
  "theme-park": { en: "Theme Park", ja: "テーマパーク", ko: "테마파크", "zh-CN": "主题公园", "zh-TW": "主題公園", th: "สวนสนุก", vi: "Công viên giải trí", ru: "Тематический парк", fr: "Parc à thème", de: "Themenpark", ar: "مدينة ملاهي", fa: "شهربازی" },
  wellness: { en: "Wellness", ja: "ウェルネス", ko: "웰니스", "zh-CN": "养生", "zh-TW": "養生", th: "สุขภาพดี", vi: "Sức khỏe", ru: "Оздоровление", fr: "Bien-être", de: "Wellness", ar: "عافية", fa: "تندرستی" },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  meta={{
    canonicalUrl: `https://chinaengage.org/${lang}/city/${city.slug}/attractions`,
  }}
>
  <!-- Hero Section -->
  <section class="relative h-64 md:h-80 bg-gradient-to-br from-purple-600 to-blue-600">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-t from-black/60 to-transparent"></div>
    </div>
    <div class="container-custom relative h-full flex flex-col justify-end pb-8">
      <!-- Breadcrumb -->
      <nav class="mb-4">
        <a href={`/${lang}/`} class="text-purple-200 hover:text-white transition-colors" data-i18n="cityPage.home">Home</a>
        <span class="text-purple-300 mx-2">/</span>
        <a href={`/${lang}/city/${city.slug}`} class="text-purple-200 hover:text-white transition-colors">{localCityName}</a>
        <span class="text-purple-300 mx-2">/</span>
        <span class="text-white" data-i18n="cityPage.attractionsHeading">{isJapanese ? `${localCityName}の観光スポット` : `Attractions`}</span>
      </nav>

      <h1 class="text-4xl md:text-5xl font-bold text-white mb-2">
        🏛️{isJapanese ? `${localCityName}の観光スポット` : (translations[lang] || translations.en).cityAttractions?.title?.replace("{city}", localCityName) ?? `Attractions in ${city.nameEn}`}
      </h1>
  <p class="text-xl text-purple-200" >{isJapanese ? `${localCityName}の${city.attractions.length}件の観光スポット` : (translations[lang] || translations.en).cityAttractions?.subtitle?.replace("{city}", localCityName)?.replace("{count}", String(city.attractions.length)) ?? `${city.nameEn} — ${city.attractions.length} places to explore`}</p>
    </div>
  </section>

  <!-- Filters & Search -->
  <section class="bg-white border-b sticky top-16 z-40">
    <div class="container-custom py-4">
      <div class="flex flex-col md:flex-row gap-4 items-start md:items-center">
        <!-- Search -->
        <div class="relative flex-1 w-full md:max-w-md">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Search attractions..." data-i18n-placeholder="cityPage.searchAttractions" data-i18n-attr="placeholder"
            class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent"
          />
        </div>

        <!-- Category filters -->
        <div class="flex flex-wrap gap-2">
          <button
            class="category-filter px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-purple-600 text-white"
            data-category="all"
          >
            All ({city.attractions.length})
          </button>
          {categories.map((cat: string) => {
            const count = city.attractions.filter((a: any) => a.category === cat).length;
            const catLabels = CAT_LABELS;
            return (
              <button
                class="category-filter px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200"
                data-category={cat}
              >
                {(catLabels[cat] && catLabels[cat][lang]) || (catLabels[cat] && catLabels[cat].en) || cat} ({count})
              </button>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Attractions Grid -->
  <section class="container-custom py-8">
  <AIRecommendation
    lang={lang}
    topic="attractions"
    topicLabel={_ft("cityPage.attractionsHeading")}
    cityName={localCityName}
    citySlug={city.slug}
  />
    <div id="attractions-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {city.attractions.map((attraction: any, index: number) => (
        <div
          class="attraction-card bg-white border border-gray-100 rounded-xl overflow-hidden card-hover"
          data-category={attraction.category}
          data-name={`${attraction.nameEn}${attraction.name !== attraction.nameEn ? ` ${attraction.name}` : ""}`.toLowerCase()}
        >
          {/* Image */}
          {attraction.image && (
            <div class="relative h-48 overflow-hidden">
              <img
                src={attraction.image}
                alt={entityDisplayName(attraction, lang)}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
                loading="lazy"
              />
              <div class="absolute top-3 left-3">
                <span class={`px-2.5 py-1 rounded-full text-xs font-semibold border ${
                  attraction.category === 'historical' ? 'bg-amber-100 text-amber-700 border-amber-200' :
                  attraction.category === 'cultural' ? 'bg-purple-100 text-purple-700 border-purple-200' :
                  attraction.category === 'natural' ? 'bg-green-100 text-green-700 border-green-200' :
                  attraction.category === 'modern' ? 'bg-blue-100 text-blue-700 border-blue-200' :
                  attraction.category === 'entertainment' ? 'bg-pink-100 text-pink-700 border-pink-200' :
                  'bg-gray-100 text-gray-700 border-gray-200'
                }`}>
                  {(CAT_LABELS[attraction.category] && CAT_LABELS[attraction.category][lang]) || (CAT_LABELS[attraction.category] && CAT_LABELS[attraction.category].en) || attraction.category.charAt(0).toUpperCase() + attraction.category.slice(1)}
                </span>
              </div>
              {attraction.ticketPrice && attraction.ticketPrice !== 'Free' && (
                <div class="absolute top-3 right-3 bg-black/70 text-white px-2.5 py-1 rounded-full text-xs font-semibold backdrop-blur-sm">
                  🎫 {attraction.ticketPrice}
                </div>
              )}
              {attraction.ticketPrice === 'Free' && (
                <div class="absolute top-3 right-3 bg-green-500 text-white px-2.5 py-1 rounded-full text-xs font-semibold">
                  FREE
                </div>
              )}
            </div>
          )}

          <div class="p-5">
            <h3 class="text-lg font-bold text-gray-900 mb-1">{entityDisplayName(attraction, lang)}</h3>
            <p class="text-gray-500 text-sm mb-3">{entitySecondaryName(attraction, lang)}</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3">{attraction.description}</p>

            <div class="space-y-2 mb-4">
              <div class="flex items-center gap-2 text-sm text-gray-600">
                <span class="text-gray-400" data-i18n="cityPage.phoneIcon">📞</span>
                <span>{attraction.openingHours}</span>
              </div>
              {attraction.address && (
                <div class="flex items-center gap-2 text-sm text-gray-600">
                  <span class="text-gray-400">📍</span>
                  <span class="truncate">{attraction.address}</span>
                </div>
              )}
            </div>

            <div class="flex flex-wrap items-center gap-3 mt-2">
              {attraction.phone && (
                <a href={`tel:${attraction.phone.replace(/\s/g, "")}`} class="inline-flex items-center gap-1 text-sm text-green-700 hover:text-green-800 font-medium hover:underline" title={isJapanese ? `${attraction.nameEn || attraction.name}に電話` : `Call ${attraction.nameEn}`}>
                  📞 {attraction.phone}
                </a>
              )}
              {attraction.coordinates && (
              <a
                href={`https://maps.google.com/maps?daddr=${attraction.coordinates.lat},${attraction.coordinates.lng}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-sm text-purple-600 hover:text-purple-700 font-medium hover:underline"
              >
                {ct(lang, "get_directions", "Get Directions")} →
              </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-16">
      <div class="text-6xl mb-4">🔍</div>
      <h3 class="text-xl font-semibold text-gray-700 mb-2" data-i18n="cityPage.noResults">No attractions found</h3>
      <p class="text-gray-500" data-i18n="cityPage.noResultsDesc">Try a different search term or category</p>
    </div>
  </section>

  <script>
    // Client-side search and filter
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const cards = document.querySelectorAll('.attraction-card');
      const filterButtons = document.querySelectorAll('.category-filter');
      const noResults = document.getElementById('no-results');

      let activeCategory = 'all';

      function filterCards() {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          const name = card.getAttribute('data-name') || '';

          const matchesCategory = activeCategory === 'all' || category === activeCategory;
          const matchesSearch = !query || name.includes(query);

          if (matchesCategory && matchesSearch) {
            (card as HTMLElement).style.display = '';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount > 0);
        }
      }

      searchInput?.addEventListener('input', filterCards);

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCategory = btn.getAttribute('data-category') || 'all';

          // Update button styles
          filterButtons.forEach((b) => {
            b.className = 'category-filter px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200';
          });
          btn.className = 'category-filter px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-purple-600 text-white';

          filterCards();
        });
      });
    });
  </script>

  <style>
    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>

  <!-- Authoritative Data Sources -->
  <section class="container-custom py-8 mt-8 border-t border-gray-200">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-lg font-semibold text-gray-700 mb-3"><span data-i18n="cityPage.dataSourcesHeading">{_ft("cityPage.dataSourcesHeading")}</span></h2>
      <div class="bg-gray-50 rounded-xl p-5 text-sm text-gray-600 space-y-2">
        <p data-i18n="cityPage.dataSourcesDesc">{_ft("cityPage.dataSourcesDesc")}</p>
        <ul class="list-disc list-inside space-y-1 ml-2">
          <li><a href="https://www.mafengwo.cn" target="_blank" rel="noopener" class="text-blue-600 hover:underline">{citySourceLabel(lang, "mafengwo")}</a>  — <span data-i18n="cityAttractions.mafengwoDesc">{_ft("cityAttractions.mafengwoDesc")}</span></li>
          <li><a href="https://www.ctrip.com" target="_blank" rel="noopener" class="text-blue-600 hover:underline">Ctrip / Trip.com</a>  — <span data-i18n="cityAttractions.ctripDesc">{_ft("cityAttractions.ctripDesc")}</span></li>
          <li><a href="https://www.tripadvisor.com" target="_blank" rel="noopener" class="text-blue-600 hover:underline">TripAdvisor</a>  — <span data-i18n="cityAttractions.tripadvisorDesc">{_ft("cityAttractions.tripadvisorDesc")}</span></li>
          <li><a href="https://www.chinanews.com" target="_blank" rel="noopener" class="text-blue-600 hover:underline">{citySourceLabel(lang, "chinanews")}</a>  — <span data-i18n="cityAttractions.chinanewsDesc">{_ft("cityAttractions.chinanewsDesc")}</span></li>
          <li><a href="https://www.mct.gov.cn" target="_blank" rel="noopener" class="text-blue-600 hover:underline">{citySourceLabel(lang, "mct")}</a>  — <span data-i18n="cityAttractions.mctDesc">{_ft("cityAttractions.mctDesc")}</span></li>
        </ul>
        <p class="text-xs text-gray-400 mt-3"><span data-i18n="cityAttractions.disclaimer">{_ft("cityAttractions.disclaimer")}</span></p>
      </div>
    </div>
  </section>
</BaseLayout>