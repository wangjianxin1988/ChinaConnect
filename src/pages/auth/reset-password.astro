---
import { ResetPasswordPage } from '@/components/user/ResetPasswordPage';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translations } from "@/i18n/translations";
import type { Language } from "@/i18n/translations";

const lang = (Astro.locals.lang as Language) || "en";
const title = (translations[lang]?.authPage?.resetTitle) || translations.en.authPage?.resetTitle || "Reset Password - ChinaConnect";
---

<BaseLayout title={title}>
  <main class="min-h-screen py-12 bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <ResetPasswordPage client:load lang={lang} />
    </div>
  </main>
</BaseLayout>
