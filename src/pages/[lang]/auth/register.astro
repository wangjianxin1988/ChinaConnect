---
export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"] as const;
  return langs.map((lang) => ({ params: { lang } }));
}

// /{lang}/auth/register - alias for /{lang}/auth/login (with mode=register via hash).
const lang = Astro.params.lang || "en";
return Astro.redirect("/" + lang + "/auth/login#register");
---
