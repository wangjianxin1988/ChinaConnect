<style>
  .faq-content {
    transition: max-height 0.3s ease-out, padding 0.3s ease-out;
  }
  .faq-item.active .faq-content {
    max-height: 200px;
  }
  .faq-item.active .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item.active {
    border-color: #818cf8;
    box-shadow: 0 0 0 1px rgba(129, 140, 248, 0.2);
  }
</style>

<script>
  // Billing toggle
  let currentBilling = "monthly";

  const billingBtns = document.querySelectorAll(".billing-toggle");
  const priceAmounts = document.querySelectorAll(".price-amount");
  const annualNotes = document.querySelectorAll(".price-annual-note");
  const savingsHint = document.getElementById("savings-hint");

  billingBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const billing = btn.getAttribute("data-billing");
      currentBilling = billing === "annual" ? "annual" : "monthly";

      billingBtns.forEach((b) => {
        if (b.getAttribute("data-billing") === billing) {
          b.classList.add("bg-white", "text-gray-900", "shadow-md");
          b.classList.remove("text-gray-500", "hover:text-gray-700");
        } else {
          b.classList.remove("bg-white", "text-gray-900", "shadow-md");
          b.classList.add("text-gray-500", "hover:text-gray-700");
        }
      });

      annualNotes.forEach((note) => {
        note.style.display = billing === "annual" ? "block" : "none";
      });

      // Swap the big price to the monthly-equivalent for the selected billing cycle.
      priceAmounts.forEach(function (el) {
        var attr = billing === "annual" ? "data-annual" : "data-monthly";
        var value = el.getAttribute(attr);
        if (value) {
          el.textContent = "$" + value;
        }
      });

      if (savingsHint) {
        savingsHint.style.display = billing === "annual" ? "block" : "none";
      }
    });
  });

  // FAQ accordion
  document.querySelectorAll(".faq-toggle").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const item = toggle.closest(".faq-item");
      const isActive = item?.classList.contains("active");

      document.querySelectorAll(".faq-item").forEach((faq) => {
        faq.classList.remove("active");
        faq.querySelector(".faq-toggle")?.setAttribute("aria-expanded", "false");
      });

      if (!isActive && item) {
        item.classList.add("active");
        toggle.setAttribute("aria-expanded", "true");
      }
    });
  });

  // Subscribe button click handler
  document.querySelectorAll(".subscribe-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const tier = btn.getAttribute("data-tier");
      if (!tier || tier === "free") return;

      const button = btn;
      const originalText = button.textContent;
      button.textContent = "Processing...";
      button.disabled = true;
      button.style.opacity = "0.7";

      try {
        // Resolve Supabase URL + access token from the global Supabase client
        // that BaseLayout already created.
        const supabaseUrl = (window).__SUPABASE_URL__ || "";
        const accessToken = (window).__SUPABASE_TOKEN__ || "";
        if (!supabaseUrl || !accessToken) {
          throw new Error("Please sign in to your ChinaConnect account before subscribing.");
        }

        // Store tier for the success page
        localStorage.setItem("pending_checkout_tier", tier);

        const response = await fetch(supabaseUrl + "/functions/v1/checkout", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + accessToken,
          },
          body: JSON.stringify({ tier, billing: currentBilling === "annual" ? "yearly" : "monthly", lang: (window.__I18N__ && window.__I18N__.serverLang) || "en" }),
        });

        const data = await response.json();

        if (!response.ok) {
          if (response.status === 503) {
            throw new Error("Payment is being configured. Please check back soon.");
          }
          throw new Error(data.message || data.error || "Failed to create checkout session");
        }

        if (data.url) {
          window.location.href = data.url;
        } else {
          throw new Error("No checkout URL returned");
        }
      } catch (error) {
        const message = error instanceof Error ? error.message : "Unknown error";
        console.error("Checkout error:", message);
        alert("Checkout error: " + message + "\n\nPlease make sure payment is configured properly.");
        button.textContent = originalText;
        button.disabled = false;
        button.style.opacity = "1";
        localStorage.removeItem("pending_checkout_tier");
      }
    });
  });

  // Highlight current tier
  const currentTier = localStorage.getItem("subscription_tier") || "free";
  document.querySelectorAll("[data-tier]").forEach((btn) => {
    const tier = btn.getAttribute("data-tier");
    if (tier === currentTier && btn.classList.contains("subscribe-btn")) {
      btn.textContent = "Current Plan ?";
      btn.disabled = true;
      btn.classList.add("opacity-60", "cursor-not-allowed");
      btn.classList.remove("subscribe-btn");
    }
    if (tier === "free" && currentTier === "free") {
      btn.textContent = "Current Plan ?";
    }
  });
</script>
