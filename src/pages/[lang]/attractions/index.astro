---
export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"];
  return langs.map((lang) => ({ params: { lang } }));
}

import EmbeddedAppRecommendation from "@/components/apps/EmbeddedAppRecommendation";
import { getCityData } from "@/data/cities-i18n";
import { citySlugs } from "@/data/cities/index";
import { translations } from "@/i18n/translations";
import { ct } from "@/i18n/components-strings";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  generateBreadcrumbSchema,
  generateCollectionPageSchema,
  generateJsonLdScript,
} from "@/lib/seo/schema-org";

const lang = (Astro.params.lang as string) || "en";
const t = translations[lang] || translations.en;
const pageTitle = t.attractions?.pageTitle ?? translations.en.attractions.pageTitle;
const pageDescription = t.attractions?.pageDescription ?? translations.en.attractions.pageDescription;

const UNIT_ATTRACTIONS: Record<string, string> = {
  en: "attractions", ja: "観光スポット", ko: "관광명소",
  "zh-CN": "景点", "zh-TW": "景點", th: "สถานที่ท่องเที่ยว",
  vi: "địa điểm tham quan", ru: "достопримечательностей", fr: "attractions",
  de: "Sehenswürdigkeiten", ar: "مناطق جذب", fa: "جاذبه‌ها",
};
const CATEGORY_TAGLINE: Record<string, string> = {
  en: "Historical, cultural, natural, modern",
  ja: "歴史、文化、自然、モダン",
  ko: "역사, 문화, 자연, 현대",
  "zh-CN": "历史、文化、自然、现代",
  "zh-TW": "歷史、文化、自然、現代",
  th: "ประวัติศาสตร์ วัฒนธรรม ธรรมชาติ และความทันสมัย",
  vi: "Lịch sử, văn hóa, thiên nhiên, hiện đại",
  ru: "Исторические, культурные, природные, современные",
  fr: "Historique, culturel, naturel, moderne",
  de: "Historisch, kulturell, natürlich, modern",
  ar: "تاريخية وثقافية وطبيعية وحديثة",
  fa: "تاریخی، فرهنگی، طبیعی، مدرن",
};
const CAT_LABELS: Record<string, Record<string, string>> = {
  cultural: { en: "cultural", ja: "文化", ko: "문화", "zh-CN": "文化", "zh-TW": "文化", th: "วัฒนธรรม", vi: "văn hóa", ru: "культурный", fr: "culturel", de: "kulturell", ar: "ثقافي", fa: "فرهنگی" },
  natural: { en: "natural", ja: "自然", ko: "자연", "zh-CN": "自然", "zh-TW": "自然", th: "ธรรมชาติ", vi: "thiên nhiên", ru: "природный", fr: "naturel", de: "natürlich", ar: "طبيعي", fa: "طبیعی" },
  nature: { en: "nature", ja: "自然", ko: "자연", "zh-CN": "自然", "zh-TW": "自然", th: "ธรรมชาติ", vi: "thiên nhiên", ru: "природа", fr: "nature", de: "Natur", ar: "طبيعة", fa: "طبیعت" },
  landmark: { en: "landmark", ja: "ランドマーク", ko: "랜드마크", "zh-CN": "地标", "zh-TW": "地標", th: "สถานที่สำคัญ", vi: "địa danh", ru: "достопримечательность", fr: "point de repère", de: "Wahrzeichen", ar: "معلم", fa: "نشانه" },
  street: { en: "street", ja: "通り", ko: "거리", "zh-CN": "街道", "zh-TW": "街道", th: "ถนน", vi: "phố", ru: "улица", fr: "rue", de: "Straße", ar: "شارع", fa: "خیابان" },
  historical: { en: "historical", ja: "歴史", ko: "역사", "zh-CN": "历史", "zh-TW": "歷史", th: "ประวัติศาสตร์", vi: "lịch sử", ru: "исторический", fr: "historique", de: "historisch", ar: "تاريخي", fa: "تاریخی" },
  museum: { en: "museum", ja: "博物館", ko: "박물관", "zh-CN": "博物馆", "zh-TW": "博物館", th: "พิพิธภัณฑ์", vi: "bảo tàng", ru: "музей", fr: "musée", de: "Museum", ar: "متحف", fa: "موزه" },
  park: { en: "park", ja: "公園", ko: "공원", "zh-CN": "公园", "zh-TW": "公園", th: "สวนสาธารณะ", vi: "công viên", ru: "парк", fr: "parc", de: "Park", ar: "حديقة", fa: "پارک" },
  temple: { en: "temple", ja: "寺院", ko: "사찰", "zh-CN": "寺庙", "zh-TW": "寺廟", th: "วัด", vi: "chùa", ru: "храм", fr: "temple", de: "Tempel", ar: "معبد", fa: "معبد" },
  modern: { en: "modern", ja: "モダン", ko: "현대", "zh-CN": "现代", "zh-TW": "現代", th: "ทันสมัย", vi: "hiện đại", ru: "современный", fr: "moderne", de: "modern", ar: "حديث", fa: "مدرن" },
  beach: { en: "beach", ja: "ビーチ", ko: "해변", "zh-CN": "海滩", "zh-TW": "海灘", th: "ชายหาด", vi: "bãi biển", ru: "пляж", fr: "plage", de: "Strand", ar: "شاطئ", fa: "ساحل" },
  entertainment: { en: "entertainment", ja: "エンタメ", ko: "오락", "zh-CN": "娱乐", "zh-TW": "娛樂", th: "ความบันเทิง", vi: "giải trí", ru: "развлечения", fr: "divertissement", de: "Unterhaltung", ar: "ترفيه", fa: "سرگرمی" },
  shopping: { en: "shopping", ja: "ショッピング", ko: "쇼핑", "zh-CN": "购物", "zh-TW": "購物", th: "ช้อปปิ้ง", vi: "mua sắm", ru: "шопинг", fr: "shopping", de: "Einkaufen", ar: "تسوق", fa: "خرید" },
  culture: { en: "culture", ja: "文化", ko: "문화", "zh-CN": "文化", "zh-TW": "文化", th: "วัฒนธรรม", vi: "văn hóa", ru: "культура", fr: "culture", de: "Kultur", ar: "ثقافة", fa: "فرهنگ" },
  market: { en: "market", ja: "市場", ko: "시장", "zh-CN": "市场", "zh-TW": "市場", th: "ตลาด", vi: "chợ", ru: "рынок", fr: "marché", de: "Markt", ar: "سوق", fa: "بازار" },
  family: { en: "family", ja: "ファミリー", ko: "가족", "zh-CN": "亲子", "zh-TW": "親子", th: "ครอบครัว", vi: "gia đình", ru: "семейный", fr: "familial", de: "Familie", ar: "عائلي", fa: "خانوادگی" },
  adventure: { en: "adventure", ja: "冒険", ko: "모험", "zh-CN": "探险", "zh-TW": "探險", th: "ผจญภัย", vi: "phiêu lưu", ru: "приключение", fr: "aventure", de: "Abenteuer", ar: "مغامرة", fa: "ماجراجویی" },
  "theme-park": { en: "theme park", ja: "テーマパーク", ko: "테마파크", "zh-CN": "主题公园", "zh-TW": "主題公園", th: "สวนสนุก", vi: "công viên giải trí", ru: "тематический парк", fr: "parc à thème", de: "Themenpark", ar: "حديقة ترفيهية", fa: "پارک موضوعی" },
  seasonal: { en: "seasonal", ja: "季節", ko: "계절", "zh-CN": "季节", "zh-TW": "季節", th: "ตามฤดูกาล", vi: "theo mùa", ru: "сезонный", fr: "saisonnier", de: "saisonal", ar: "موسمي", fa: "فصلی" },
  resort: { en: "resort", ja: "リゾート", ko: "리조트", "zh-CN": "度假村", "zh-TW": "度假村", th: "รีสอร์ท", vi: "khu nghỉ dưỡng", ru: "курорт", fr: "station", de: "Resort", ar: "منتجع", fa: "استراحتگاه" },
  island: { en: "island", ja: "島", ko: "섬", "zh-CN": "岛屿", "zh-TW": "島嶼", th: "เกาะ", vi: "đảo", ru: "остров", fr: "île", de: "Insel", ar: "جزيرة", fa: "جزیره" },
  wellness: { en: "wellness", ja: "ウェルネス", ko: "웰니스", "zh-CN": "养生", "zh-TW": "養生", th: "สุขภาพ", vi: "chăm sóc sức khỏe", ru: "оздоровление", fr: "bien-être", de: "Wellness", ar: "عافية", fa: "تندرستی" },
  aquarium: { en: "aquarium", ja: "水族館", ko: "아쿠아리움", "zh-CN": "水族馆", "zh-TW": "水族館", th: "พิพิธภัณฑ์สัตว์น้ำ", vi: "thủy cung", ru: "аквариум", fr: "aquarium", de: "Aquarium", ar: "حوض أسماك", fa: "آکواریوم" },
  sports: { en: "sports", ja: "スポーツ", ko: "스포츠", "zh-CN": "体育", "zh-TW": "體育", th: "กีฬา", vi: "thể thao", ru: "спорт", fr: "sport", de: "Sport", ar: "رياضة", fa: "ورزش" },
  festival: { en: "festival", ja: "祭り", ko: "축제", "zh-CN": "节日", "zh-TW": "節日", th: "เทศกาล", vi: "lễ hội", ru: "фестиваль", fr: "festival", de: "Festival", ar: "مهرجان", fa: "جشنواره" },
};
const catLabel = (cat: string): string => CAT_LABELS[cat]?.[lang] || CAT_LABELS[cat]?.en || cat;

type AttractionLike = {
  id?: string;
  name?: string;
  nameEn?: string;
  category?: string;
  description?: string;
  image?: string;
};

type CityLike = {
  slug: string;
  name: string;
  nameEn: string;
  coverImage?: string;
  attractions?: AttractionLike[];
};

const cityData = citySlugs.map((slug) => getCityData(slug, lang)).filter(Boolean) as CityLike[];
const cityName = (slug: string, fallback: string): string => {
  const localized = (t.city as Record<string, { name?: string }> | undefined)?.[slug]?.name;
  return localized || fallback;
};

const allAttractions: Array<
  AttractionLike & {
    citySlug: string;
    cityNameEn: string;
    cityCover: string | undefined;
  }
> = [];

let totalAttractions = 0;
const citiesWithAttractions: Array<{
  slug: string;
  nameEn: string;
  count: number;
  coverImage: string | undefined;
}> = [];

for (const city of cityData) {
  const list = city.attractions || [];
  if (list.length === 0) continue;
  totalAttractions += list.length;
  citiesWithAttractions.push({
    slug: city.slug,
    nameEn: cityName(city.slug, city.nameEn || city.name),
    count: list.length,
    coverImage: city.coverImage,
  });
  for (const a of list) {
    allAttractions.push({
      ...a,
      citySlug: city.slug,
      cityNameEn: cityName(city.slug, city.nameEn || city.name),
      cityCover: city.coverImage,
    });
  }
}

const categoryCounts: Record<string, number> = {};
for (const a of allAttractions) {
  const cat = (a.category || "other").toString();
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
}
citiesWithAttractions.sort((a, b) => b.count - a.count);

const attractionSchemas = [
  generateCollectionPageSchema({
    name: "Must-Visit Attractions in China on ChinaConnect",
    description: `Discover ${totalAttractions}+ tourist attractions across Chinese cities`,
    url: `https://chinaengage.org/${lang}/attractions`,
    numberOfItems: totalAttractions,
  }),
  generateBreadcrumbSchema([
    { name: "Home", url: "https://chinaengage.org/" },
    { name: "Attractions", url: `https://chinaengage.org/${lang}/attractions` },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  meta={{
    keywords: ['China attractions', 'Beijing attractions', 'Shanghai attractions', 'Great Wall', 'Forbidden City', 'tourist spots'],
  }}
  lang={lang}>
  <!-- Schema.org JSON-LD for SEO/GEO -->
  <script type="application/ld+json" set:html={generateJsonLdScript(attractionSchemas)} />

  <main class="container mx-auto px-4 py-8">
    <!-- Hero -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2" data-i18n="attractions.title">China Attractions</h1>
      <p class="text-gray-600 text-lg" data-i18n="attractions.subtitle">Must-visit tourist spots across China &mdash; from ancient landmarks to natural wonders</p>
      <div class="flex flex-wrap gap-4 mt-4 text-sm text-gray-700">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-blue-700 rounded-full">
          <span>&#127963;</span>
          <strong>{totalAttractions}</strong> {UNIT_ATTRACTIONS[lang] || UNIT_ATTRACTIONS.en}
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-purple-50 text-purple-700 rounded-full">
          <span>&#127961;</span>
          <strong>{citiesWithAttractions.length}</strong> {ct(lang, "scenic_unit_cities", "cities")}
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 rounded-full">
          <span>&#128509;</span>
          {CATEGORY_TAGLINE[lang] || CATEGORY_TAGLINE.en}
        </span>
      </div>
    </div>

    <!-- Category filter chips (informational; quick visual overview) -->
    {Object.keys(categoryCounts).length > 0 && (
      <section class="mb-8">
        <h2 class="text-xl font-semibold mb-3 text-gray-900" data-i18n="attractions.browseCategory">Browse by Category</h2>
        <div class="flex flex-wrap gap-2">
          {Object.entries(categoryCounts).map(([cat, count]) => (
            <a
              href={`#cat-${cat}`}
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-50 hover:bg-gray-100 text-sm text-gray-700 border border-gray-200"
            >
              <span class="font-medium capitalize">{catLabel(cat)}</span>
              <span class="text-xs text-gray-500">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Featured cities (most attractions) -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4 text-gray-900" data-i18n="attractions.featured">Featured Cities</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {citiesWithAttractions.slice(0, 12).map((city) => (
          <a
            href={`/${lang}/city/${city.slug}#attractions`}
            class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all"
          >
            <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
              {city.coverImage ? (
                <img
                  src={city.coverImage}
                  alt={`${city.nameEn} ${UNIT_ATTRACTIONS[lang] || UNIT_ATTRACTIONS.en}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-2xl">&#127961;</div>
              )}
            </div>
            <div class="p-3">
              <p class="font-semibold text-gray-900 truncate">{city.nameEn}</p>
              <p class="text-xs text-gray-500 mt-0.5">{city.count} {UNIT_ATTRACTIONS[lang] || UNIT_ATTRACTIONS.en}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- All cities with attraction counts -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4 text-gray-900" data-i18n="attractions.featured">All Cities with Attractions</h2>
      <div class="bg-white rounded-xl border border-gray-200 divide-y divide-gray-100">
        {citiesWithAttractions.map((city) => (
          <a
            href={`/${lang}/city/${city.slug}#attractions`}
            class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-gray-50 transition-colors"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-2xl">&#127961;</span>
              <div class="min-w-0">
                <p class="font-medium text-gray-900 truncate">{city.nameEn}</p>
              </div>
            </div>
            <span class="shrink-0 inline-flex items-center gap-1.5 text-sm text-gray-700">
              <span class="font-semibold">{city.count}</span> {UNIT_ATTRACTIONS[lang] || UNIT_ATTRACTIONS.en}
              <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- App recommendations for trip planning -->
    <EmbeddedAppRecommendation
      client:visible
      categories={["travel", "maps", "transport", "language"]}
      title={t.attractions?.appTitle ?? "Plan Your Trip"}
      subtitle={t.attractions?.appSubtitle ?? "Useful apps for getting around and finding attractions"}
    />
  </main>
</BaseLayout>
