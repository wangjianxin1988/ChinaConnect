---

/**
 * Checkout Success Page
 * Shown after successful Creem checkout
 * Retrieves session details and updates localStorage
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translations } from "@/i18n/translations";

const title = translations.en.checkoutPage?.title || "Payment Successful - ChinaConnect";
const description = translations.en.checkoutPage?.description || "Your subscription has been activated successfully";
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-gradient-to-b from-green-50 to-white flex items-center justify-center py-16">
    <div class="max-w-lg mx-auto text-center px-4">
      <!-- Loading State -->
      <div id="checkout-loading">
        <div class="animate-spin rounded-full h-16 w-16 border-b-4 border-green-600 mx-auto mb-6"></div>
        <h1 class="text-2xl font-bold text-gray-900 mb-2"><span data-i18n="checkoutPage.processing">Processing your payment...</span></h1>
        <p class="text-gray-500" data-i18n="checkoutPage.processingDesc">Please wait while we confirm your subscription.</p>
      </div>

      <!-- Success State (hidden by default) -->
      <div id="checkout-success" class="hidden">
        <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mb-3" data-i18n="checkoutPage.successTitle">Payment Successful! 🎉</h1>
        <p class="text-lg text-gray-600 mb-2" id="success-message" data-i18n="checkoutPage.successDesc">
          Your subscription has been activated.
        </p>
        <p class="text-sm text-gray-500 mb-8" data-i18n="checkoutPage.successAccess">
          You now have access to all the features of your new plan.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/ai"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors"
          >
            <span data-i18n="checkoutPage.startPlanning">Start Planning →</span>
          </a>
          <a
            href="/account"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors"
          >
            <span data-i18n="checkoutPage.viewAccount">View Account</span>
          </a>
        </div>
      </div>

      <!-- Error State (hidden by default) -->
      <div id="checkout-error" class="hidden">
        <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mb-3" data-i18n="checkoutPage.errorTitle">Something went wrong</h1>
        <p class="text-gray-600 mb-8" data-i18n="checkoutPage.errorDesc">
          We couldn't verify your payment. Please contact support if you were charged.
        </p>
        <a
          href="/pricing"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors"
        >
          <span data-i18n="checkoutPage.backToPricing">Back to Pricing</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  async function verifyCheckout() {
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get("session") || params.get("session_id");

    const loadingEl = document.getElementById("checkout-loading");
    const successEl = document.getElementById("checkout-success");
    const errorEl = document.getElementById("checkout-error");
    const messageEl = document.getElementById("success-message");

    if (!sessionId) {
      loadingEl?.classList.add("hidden");
      errorEl?.classList.remove("hidden");
      return;
    }

    try {
      // Wait briefly so the webhook has time to land
      await new Promise((resolve) => setTimeout(resolve, 1500));

      const supabaseUrl = (window).__SUPABASE_URL__ || "";
      const accessToken = (window).__SUPABASE_TOKEN__ || "";

      if (supabaseUrl && accessToken) {
        // Pull the current membership from Supabase and surface the real tier
        const res = await fetch(supabaseUrl + "/rest/v1/user_memberships?select=membership_tiers(slug,name),status,expires_at&status=eq.active&order=created_at.desc&limit=1", {
          headers: {
            apikey: (window).__SUPABASE_ANON_KEY__ || "",
            Authorization: "Bearer " + accessToken,
          },
        });
        if (res.ok) {
          const rows = await res.json();
          const tier = rows?.[0]?.membership_tiers?.slug;
          const tierName = rows?.[0]?.membership_tiers?.name;
          if (tier) {
            localStorage.setItem("subscription_tier", tier);
            if (tierName && messageEl) {
              messageEl.textContent = "Your " + tierName + " plan is now active.";
            }
          }
        }
      }

      // Fall back to the pending tier that pricing.astro stashed
      const pendingTier = localStorage.getItem("pending_checkout_tier");
      if (pendingTier && !localStorage.getItem("subscription_tier")) {
        localStorage.setItem("subscription_tier", pendingTier);
        if (messageEl) {
          messageEl.textContent = "Your " + pendingTier.charAt(0).toUpperCase() + pendingTier.slice(1) + " plan is now active.";
        }
      }
      localStorage.removeItem("pending_checkout_tier");

      loadingEl?.classList.add("hidden");
      successEl?.classList.remove("hidden");
    } catch (error) {
      console.error("Checkout verification error:", error);
      loadingEl?.classList.add("hidden");
      successEl?.classList.remove("hidden");
    }
  }

  verifyCheckout();
</script>
