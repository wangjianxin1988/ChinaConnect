---

export function getStaticPaths() {
  const langs = ["ja","ko","zh-CN","zh-TW","th","vi","ru","fr","de","ar","fa"];
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang as string) || "en";


import ExpoCalendarClient from "@/components/Guide/ExpoCalendarClient";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { translations } from "@/i18n/translations";
import { getLangFromUrl } from '@/i18n/utils';
---

<BaseLayout
  title={(translations[lang] || translations.en).businessGuidePage?.expoTitle || "China Expo Calendar - ChinaConnect"}
  description={(translations[lang] || translations.en).businessGuidePage?.expoDescription || "Complete calendar of major trade fairs and exhibitions in China including Canton Fair, auto shows, and industry events. Plan your business trip around key events."}
  meta={{
    keywords: ['China expo calendar', 'Canton Fair dates', 'Canton Fair', 'China trade shows 2026', 'China expo calendar'],
  }}
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <a href={`/${lang}/guide`} class="text-primary hover:underline mb-4 inline-block flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span data-i18n="businessGuidePage.backToGuide">← Back to Travel Guide</span>
      </a>
      <div class="flex items-center gap-3 mb-3">
        <span class="text-4xl">📅</span>
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-foreground" data-i18n="businessGuidePage.expoShort">Expo & Event Calendar</h1>
          <p class="text-muted-foreground text-lg" data-i18n="businessGuidePage.expoSubtitle">Expo &amp; Event Calendar</p>
        </div>
      </div>
      <p class="text-muted-foreground max-w-2xl" data-i18n="businessGuidePage.expoDescription">Plan your business visits around China&apos;s most important trade shows.
        From the Canton Fair to industry-specific exhibitions across major cities.</p>
    </div>

    <ExpoCalendarClient client:load lang={lang} />
  </main>
</BaseLayout>