---
import { ct } from "@/i18n/components-strings";
import EmbeddedAppRecommendation from "@/components/apps/EmbeddedAppRecommendation";
import { cities } from "@/data/cities/index";
import { getLangFromUrl } from "@/i18n/utils";
import { translations } from "@/i18n/translations";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  generateBreadcrumbSchema,
  generateCollectionPageSchema,
  generateJsonLdScript,
} from "@/lib/seo/schema-org";

const lang = getLangFromUrl(Astro.url);
const t = translations[lang] || translations.en;
const pageTitle = (t.scenicSpots && t.scenicSpots.pageTitle) || (translations.en.scenicSpots && translations.en.scenicSpots.pageTitle) || "Scenic Spots - ChinaConnect";
const pageDescription = (t.scenicSpots && t.scenicSpots.pageDescription) || (translations.en.scenicSpots && translations.en.scenicSpots.pageDescription) || "Explore China's most beautiful natural scenery and scenic spots - mountains, lakes, rivers, forests, and geological wonders across all provinces.";

type AttractionLike = {
  id?: string;
  name?: string;
  nameEn?: string;
  category?: string;
  description?: string;
  image?: string;
  address?: string;
  ticketPrice?: string;
  openingHours?: string;
  recommendedVisitTime?: string;
};

type CityLike = {
  slug: string;
  name: string;
  nameEn: string;
  coverImage?: string;
  attractions?: AttractionLike[];
};

// Collect attractions across all cities
const allScenic: Array<AttractionLike & { citySlug: string; cityNameEn: string; cityName: string; cityCover: string | undefined; }> = [];
const citiesWithScenic: Array<{ slug: string; nameEn: string; name: string; count: number; coverImage: string | undefined; }> = [];

for (const city of cities as CityLike[]) {
  const list = city.attractions || [];
  if (list.length === 0) continue;
  citiesWithScenic.push({
    slug: city.slug,
    nameEn: city.nameEn,
    name: city.name,
    count: list.length,
    coverImage: city.coverImage,
  });
  for (const a of list) {
    allScenic.push({
      ...a,
      citySlug: city.slug,
      cityNameEn: city.nameEn,
      cityName: city.name,
      cityCover: city.coverImage,
    });
  }
}

citiesWithScenic.sort((a, b) => b.count - a.count);

const categoryCounts: Record<string, number> = {};
for (const a of allScenic) {
  const cat = (a.category || "other").toString();
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
}
const categories = Object.keys(categoryCounts).sort();
const SCENIC_SSR_COUNT = 36;
const SCENIC_CHUNK = 36;
const initialScenic = allScenic.slice(0, SCENIC_SSR_COUNT);
const jsonUrl = "/scenic-data/en.json";

const scenicSchemas = [
  generateCollectionPageSchema({
    name: "Scenic Spots in China - ChinaConnect",
    description: pageDescription,
    url: "https://chinaengage.org/scenic-spots",
    numberOfItems: allScenic.length,
  }),
  generateBreadcrumbSchema([
    { name: "Home", url: "https://chinaengage.org/" },
    { name: "Scenic Spots", url: "https://chinaengage.org/scenic-spots" },
  ]),
];

const keywords = [
  "China scenic spots",
  "China nature",
  "China mountains",
  "China lakes",
  "Zhangjiajie",
  "Guilin",
  "Huangshan",
  "Jiuzhaigou",
  "China travel",
];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  meta={{
    keywords,
  }}
  lang={lang}
>
  <script type="application/ld+json" set:html={generateJsonLdScript(scenicSchemas)} />

  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2" data-i18n="scenicSpots.title">Scenic Spots</h1>
      <p class="text-gray-600 text-lg" data-i18n="scenicSpots.subtitle">Majestic mountains, serene lakes, deep gorges and natural wonders across China</p>
      <div class="flex flex-wrap gap-4 mt-4 text-sm text-gray-700">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 rounded-full">
          <span>&#127796;</span>
          <strong>{allScenic.length}</strong> scenic spots
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-blue-700 rounded-full">
          <span>&#127961;</span>
          <strong>{citiesWithScenic.length}</strong> cities
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-purple-50 text-purple-700 rounded-full">
          <span>&#127956;</span>
          Historical, cultural, natural, modern
        </span>
      </div>
    </div>

    <!-- Featured scenic cities -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4 text-gray-900" data-i18n="scenicSpots.featuredCities">Featured Scenic Cities</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {citiesWithScenic.slice(0, 12).map((city) => (
          <a
            href={`/city/${city.slug}#attractions`}
            class="group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-green-300 hover:shadow-md transition-all"
          >
            <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
              {city.coverImage ? (
                <img
                  src={city.coverImage}
                  alt={`${city.nameEn} scenic spots`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-2xl">&#127796;</div>
              )}
            </div>
            <div class="p-3">
              <p class="font-semibold text-gray-900 truncate">{city.nameEn}</p>
              <p class="text-xs text-gray-500 mt-0.5">{city.count} scenic spots</p>
            </div>
          </a>
        ))}
      </div>
    </section>


    <!-- All scenic spots -->
    <section id="scenic-app" class="mb-10" data-json-url={jsonUrl} data-ssr-count={SCENIC_SSR_COUNT} data-chunk-size={SCENIC_CHUNK} data-total={allScenic.length} data-load-more={ct("en", "scenic_load_more", "Load more")} data-all-cities={ct("en", "scenic_all_cities", "All cities")} data-shown-of={ct("en", "scenic_shown_of", "Showing {shown} of {total}")} data-loading={ct("en", "list_loading_more", "Loading more...")}>

    <!-- Category filter -->
    <div class="mb-6">
      <div class="flex flex-wrap gap-2">
        <button
          class="scenic-category-filter px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-green-600 text-white"
          data-category="all"
        >
          All ({allScenic.length})
        </button>
        {categories.map((cat) => (
          <button
            class="scenic-category-filter px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200 capitalize"
            data-category={cat}
          >
            {cat} ({categoryCounts[cat]})
          </button>
        ))}
      </div>
    </div>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h2 class="text-xl font-semibold text-gray-900" data-i18n="scenicSpots.allSpots">All Scenic Spots</h2>
        <label class="sr-only" for="scenic-city-filter">{ct("en", "scenic_all_cities", "All cities")}</label>
        <select id="scenic-city-filter" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800" aria-label={ct("en", "scenic_all_cities", "All cities")}>
          <option value="all">{ct("en", "scenic_all_cities", "All cities")}</option>
          {citiesWithScenic.map((city) => (
            <option value={city.slug}>{city.nameEn}</option>
          ))}
        </select>
      </div>
      <div id="scenic-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {initialScenic.map((a) => (
          <a
            href={'/city/' + a.citySlug + '#attractions'}
            class="scenic-card group bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-green-300 hover:shadow-md transition-all"
            data-category={(a.category || "other").toString()}
            data-city={a.citySlug}
          >
            <div class="aspect-[16/9] bg-gray-100 overflow-hidden">
              {a.image ? (
                <img
                  src={a.image}
                  alt={a.nameEn || a.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-3xl">&#127796;</div>
              )}
            </div>
            <div class="p-4">
              <p class="text-xs text-green-600 font-medium mb-1">{a.cityNameEn}</p>
              <h3 class="font-semibold text-gray-900 mb-1 truncate">{a.nameEn || a.name}</h3>
              <p class="text-sm text-gray-600 line-clamp-2">{a.description}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center">
        <button id="scenic-load-more" class="px-5 py-2.5 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-700 transition-colors">
          {ct("en", "scenic_load_more", "Load more")}
        </button>
        <p id="scenic-status" class="text-sm text-gray-500 mt-2 hidden"></p>
      </div>
      <div id="scenic-sentinel" class="h-px" aria-hidden="true"></div>
    </section>

    <EmbeddedAppRecommendation client:idle categories={["travel", "maps", "transport"]} title={t.scenicSpots?.appTitle ?? "Plan Your Scenic Spot Visit"} subtitle={t.scenicSpots?.appSubtitle ?? "Apps for finding and navigating scenic spots in China"} />
  </main>
</BaseLayout>

<script>
  import { initScenicLazy } from "@/scripts/scenic-lazy";

  const scenicApp = document.getElementById("scenic-app");
  if (scenicApp) {
    initScenicLazy(scenicApp as HTMLElement);
  }
</script>
